---
// Mismo trazo que /icons/pawn.svg pero en línea y con stroke="currentColor",
// para poder teñirlo por CSS (p. ej. con el color de rango del árbitro) en
// vez de quedar fijo en blanco. Se usa como placeholder cuando un árbitro
// no tiene foto, en lugar de una bolita con iniciales genérica.
interface Props {
  class?: string;
  style?: Record<string, string> | string;
}

const { class: className = '', style } = Astro.props;
---
<svg
  class={`pawn-mark ${className}`}
  style={style}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M27.78,16.0353a6.3866,6.3866,0,1,0-7.559,0"
    stroke="currentColor"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M27.7791,16.0348,32.31,19.0181a8.4613,8.4613,0,0,1-.7678,2.6175H16.4579a8.4613,8.4613,0,0,1-.7678-2.6175l4.5308-2.9833"
    stroke="currentColor"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M27.5287,21.6356c0,9.0738,9.3879,10.4,9.3879,19.1946-1.745,2.19-7.93,2.67-12.9166,2.67s-11.1716-.4794-12.9166-2.67c0-8.7946,9.3879-10.1208,9.3879-19.1946"
    stroke="currentColor"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
