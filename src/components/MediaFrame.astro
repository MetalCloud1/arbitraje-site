---
// Muestra una imagen completa (sin recortar, object-fit: contain) sobre un
// fondo hecho con la misma imagen ampliada y difuminada, para que nunca
// queden franjas negras/vacías cuando la proporción de la imagen no calza
// exactamente con el contenedor. Se usa dentro de un contenedor con
// position: relative y un tamaño/aspect-ratio ya definido.
interface Props {
  imageUrl: string | null;
  alt: string;
  isVideo?: boolean;
  playSize?: 'sm' | 'md';
  eager?: boolean;
  /**
   * Nombre único de view-transition (p. ej. `article-cover-${slug}`).
   * Cuando el mismo nombre aparece en la miniatura de un listado y en la
   * portada del artículo, el ClientRouter de Astro anima la imagen como una
   * sola pieza continua entre ambas páginas en lugar de cortar y reemplazar.
   */
  transitionName?: string;
}

const { imageUrl, alt, isVideo = false, playSize = 'md', eager = false, transitionName } = Astro.props;
---
<div class="media-frame" {...(transitionName ? { 'transition:name': transitionName } : {})}>
  {imageUrl && (
    <>
      <div class="media-frame-bg" style={`background-image:url(${imageUrl})`}></div>
      <img
        class="media-frame-fg"
        src={imageUrl}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        onerror="this.closest('.media-frame')?.classList.add('is-broken')"
      />
      <div class="media-frame-fallback" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="4" width="18" height="16" rx="2"/>
          <path d="M3 16l5-5 4 4 3-3 6 6"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
        </svg>
        <span>Imagen no disponible</span>
      </div>
    </>
  )}
  {isVideo && (
    <span class={`article-thumb-play ${playSize === 'sm' ? 'article-thumb-play-sm' : ''}`} aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    </span>
  )}
</div>
