---
import SearchBox from './SearchBox.astro';
import { SITE_NAME, SOCIAL_LINKS } from '../lib/site';

// Enlaces del menú lateral (mobile). Mismos destinos y misma lógica de
// "activo" que la barra de categorías de desktop (CategoryBar.astro).
const path = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Inicio', active: path === '/' },
  { href: '/articulos', label: 'Artículos', active: path.startsWith('/articulos') },
  { href: '/arbitros', label: 'Árbitros', active: path.startsWith('/arbitros') },
  { href: '/entrenadores', label: 'Entrenadores', active: path === '/entrenadores' },
  { href: '/clubes', label: 'Clubes', active: path.startsWith('/clubes') },
  { href: '/sobre-nosotros', label: 'Sobre Nosotros', active: path === '/sobre-nosotros' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-cluster" aria-label="La Hora del Arbitraje - Inicio">
      <h1 class="brand-h1">
          <img 
            class="brand-title" 
            src="/site-title.webp" 
            alt="La Hora del Arbitraje - Noticias, entrevistas y análisis de arbitraje en ajedrez competitivo" 
            width="198" 
            height="56" 
          />
        </h1>
      <div class="brand-divider"></div>
      <div class="brand-ally">
        <span class="brand-ally-label">En alianza con</span>
        <img class="chess-logo chess-logo-ally" src="/logo.svg" alt="Chess.com" width="92" height="26" />
      </div>
    </a>

    <div class="header-right">
      <div class="social-links">
        <a href="https://www.facebook.com/LaHoradelArbitraje" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="La Hora del Arbitraje en Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.476h-1.26c-1.243 0-1.63.775-1.63 1.57v1.888h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z"/></svg>
        </a>
        <a href="https://www.youtube.com/@lahoradelarbitraje" class="social-link" target="_blank" rel="noopener noreferrer" aria-label="La Hora del Arbitraje en YouTube">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.582 7.186a2.51 2.51 0 0 0-1.768-1.778C18.254 5 12 5 12 5s-6.254 0-7.814.408a2.51 2.51 0 0 0-1.768 1.778C2 8.756 2 12 2 12s0 3.244.418 4.814a2.51 2.51 0 0 0 1.768 1.778C5.746 19 12 19 12 19s6.254 0 7.814-.408a2.51 2.51 0 0 0 1.768-1.778C22 15.244 22 12 22 12s0-3.244-.418-4.814ZM10 15.5v-7l6 3.5-6 3.5Z"/></svg>
        </a>
      </div>

      {/* Solo visible en mobile (ver @media en global.css): en desktop el
          buscador sigue viviendo únicamente en la barra de categorías, de
          siempre. panelId distinto para no repetir el id del otro
          <SearchBox /> en la misma página. */}
      <div class="mobile-search">
        <SearchBox panelId="search-panel-mobile" />
      </div>

      {/* Solo visible en mobile (ver @media en global.css), donde reemplaza
          a .social-links: esos enlaces ya están en el footer y son una
          salida del sitio que no aporta en la pantalla más apretada; en su
          lugar va el acceso al menú, que sí es navegación imprescindible
          ahí. En desktop no compite con nada porque sigue oculto. */}
      <button
        type="button"
        class="mobile-menu-toggle"
        id="mobile-menu-toggle"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Abrir menú"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  {/* Menú lateral (mobile). Es un <dialog> modal a propósito:
      - showModal() lo pinta en la "top layer" del navegador, por encima de
        todo, sin pelear con los z-index ni con el transform del header
        sticky (que de otro modo lo atraparía).
      - El foco queda contenido dentro, el resto de la página se vuelve
        inerte y Escape lo cierra, sin escribir nada de eso a mano.
      Vive dentro del <header> (no como hijo directo de <body>) para que la
      regla genérica "body > * { position: relative }" no le pise el
      position: fixed. Los estilos están en global.css (.mobile-drawer). */}
  <dialog class="mobile-drawer" id="mobile-nav-panel" aria-label="Menú de navegación">
    <div class="drawer-inner">
      <div class="drawer-head">
        <button type="button" class="drawer-close" data-drawer-close aria-label="Cerrar menú">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>

      <nav class="drawer-nav" aria-label="Navegación principal">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`drawer-link${link.active ? ' active' : ''}`}
            aria-current={link.active ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="drawer-foot">
        <a href={SOCIAL_LINKS.facebook} class="drawer-social" target="_blank" rel="noopener noreferrer" aria-label={`${SITE_NAME} en Facebook`}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.476h-1.26c-1.243 0-1.63.775-1.63 1.57v1.888h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z"/></svg>
          Facebook
        </a>
        <a href={SOCIAL_LINKS.youtube} class="drawer-social" target="_blank" rel="noopener noreferrer" aria-label={`${SITE_NAME} en YouTube`}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M21.582 7.186a2.51 2.51 0 0 0-1.768-1.778C18.254 5 12 5 12 5s-6.254 0-7.814.408a2.51 2.51 0 0 0-1.768 1.778C2 8.756 2 12 2 12s0 3.244.418 4.814a2.51 2.51 0 0 0 1.768 1.778C5.746 19 12 19 12 19s6.254 0 7.814-.408a2.51 2.51 0 0 0 1.768-1.778C22 15.244 22 12 22 12s0-3.244-.418-4.814ZM10 15.5v-7l6 3.5-6 3.5Z"/></svg>
          YouTube
        </a>
      </div>
    </div>
  </dialog>
</header>

<script>
  function initHeader() {
    const header = document.querySelector('header.site-header');

    const onScroll = () => {
      header?.classList.toggle('is-scrolled', window.scrollY > 12);
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // El header se reemplaza por completo en cada navegación del
    // ClientRouter, pero el listener de scroll queda colgado de window,
    // que sí sobrevive. Lo quitamos antes de cada swap para no
    // acumularlos ni apuntar a nodos ya removidos (mismo patrón que en
    // ReadingProgress.astro).
    document.addEventListener(
      'astro:before-swap',
      () => window.removeEventListener('scroll', onScroll),
      { once: true }
    );
  }

  // Se registra una sola vez, pero corre en cada carga: tanto la inicial
  // como cada navegación SPA disparan 'astro:page-load'.
  document.addEventListener('astro:page-load', initHeader);

  // Menú lateral (mobile). El botón hamburguesa vive en el header y el
  // panel es un <dialog> modal que entra deslizándose desde la derecha (la
  // animación es puro CSS, ver .mobile-drawer en global.css). Acá solo se
  // conectan el botón, el cierre y el gesto de "arrastrar para cerrar".
  function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-nav-panel');
    if (!(toggle instanceof HTMLButtonElement) || !(drawer instanceof HTMLDialogElement)) return;

    const openMenu = () => {
      if (drawer.open) return;
      drawer.showModal();
      toggle.setAttribute('aria-expanded', 'true');
    };

    // 'close' se dispara siempre que el diálogo se cierre, sea por Escape,
    // por drawer.close() o por cualquier otro camino: un solo lugar para
    // dejar el botón en su estado normal. El foco vuelve solo al botón.
    const onClose = () => toggle.setAttribute('aria-expanded', 'false');

    // Cierra al tocar el fondo oscuro (::backdrop): ese clic llega al
    // propio <dialog>, mientras que los clics dentro del panel llegan a
    // sus hijos (.drawer-inner ocupa todo el alto).
    const onDrawerClick = (e: MouseEvent) => {
      const target = e.target as Element;
      if (target === drawer || target.closest('.drawer-link, [data-drawer-close]')) {
        drawer.close();
      }
    };

    // Si la pantalla pasa a tamaño desktop con el menú abierto (rotar el
    // teléfono, resize de ventana), lo cerramos: a ese ancho el botón ya
    // ni se muestra.
    const desktopQuery = window.matchMedia('(min-width: 861px)');
    const onDesktopChange = (e: MediaQueryListEvent) => {
      if (e.matches && drawer.open) drawer.close();
    };

    // ---- Arrastrar hacia la derecha para cerrar (solo táctil) ----
    // touch-action: pan-y en el CSS deja que el navegador siga manejando el
    // scroll vertical y nos entrega solo los movimientos horizontales.
    let startX = 0;
    let startY = 0;
    let startTime = 0;
    let offset = 0;
    let tracking = false;
    let dragging = false;

    const onPointerDown = (e: PointerEvent) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      dragging = false;
      startX = e.clientX;
      startY = e.clientY;
      startTime = e.timeStamp;
      offset = 0;
    };

    const onPointerMove = (e: PointerEvent) => {
      if (!tracking) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;

      if (!dragging) {
        // Si el gesto es más vertical que horizontal, es scroll: lo soltamos.
        if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) {
          tracking = false;
          return;
        }
        if (dx > 10 && dx > Math.abs(dy)) {
          dragging = true;
          drawer.setPointerCapture(e.pointerId);
          drawer.style.transition = 'none'; // sigue al dedo, sin retraso
        } else {
          return;
        }
      }

      offset = Math.max(0, dx);
      drawer.style.translate = `${offset}px 0`;
    };

    const onPointerEnd = (e: PointerEvent) => {
      if (!tracking) return;
      tracking = false;
      if (!dragging) return;
      dragging = false;

      const velocity = offset / Math.max(1, e.timeStamp - startTime); // px/ms
      const shouldClose = offset > drawer.offsetWidth * 0.33 || velocity > 0.6;

      // Se sueltan los estilos inline: el CSS retoma desde la posición
      // actual y anima hacia cerrado (o de vuelta a abierto) por sí solo.
      drawer.style.transition = '';
      drawer.style.translate = '';
      if (shouldClose) drawer.close();
    };

    toggle.addEventListener('click', openMenu);
    drawer.addEventListener('click', onDrawerClick);
    drawer.addEventListener('close', onClose);
    drawer.addEventListener('pointerdown', onPointerDown);
    drawer.addEventListener('pointermove', onPointerMove);
    drawer.addEventListener('pointerup', onPointerEnd);
    drawer.addEventListener('pointercancel', onPointerEnd);
    desktopQuery.addEventListener('change', onDesktopChange);

    // Antes de reemplazar la página (ClientRouter): cerrar sin animación y
    // soltar el listener de media query, que sí sobrevive al cambio de DOM.
    document.addEventListener(
      'astro:before-swap',
      () => {
        if (drawer.open) drawer.close();
        desktopQuery.removeEventListener('change', onDesktopChange);
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
