---
import SearchBox from './SearchBox.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (path === href ? 'active' : '');
---
<header class="site-header">
  <div class="header-inner">
    <div class="brand-cluster">
      <img class="brand-title" src="/site-title.webp" alt="La Hora del Arbitraje" />
      <div class="brand-divider"></div>
      <img class="chess-logo chess-logo-ally" src="/logo.svg" alt="Chess.com" />
    </div>

    <nav class="main-nav">
      <a href="/" class={isActive('/')}>Inicio</a>

      <div class="nav-dropdown">
        <a
          href="/articulos"
          class={`nav-dropdown-trigger ${path.startsWith('/articulos') ? 'active' : ''}`}
          aria-haspopup="true"
        >
          Artículos
          <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
        </a>
        <div class="nav-dropdown-menu">
          <a href="/articulos?categoria=Casos">Casos</a>
          <a href="/articulos?categoria=Entrevistas">Entrevistas</a>
          <a href="/articulos?categoria=Análisis">Análisis</a>
          <a href="/articulos?categoria=Podcast">Podcast</a>
        </div>
      </div>

      <a href="/arbitros" class={isActive('/arbitros')}>Árbitros</a>
      <a href="/entrenadores" class={isActive('/entrenadores')}>Entrenadores</a>
      <a href="/cursos" class={isActive('/cursos')}>Cursos</a>
      <a href="/sobre-nosotros" class={isActive('/sobre-nosotros')}>Sobre Nosotros</a>
    </nav>

    <SearchBox />

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<div class="mobile-menu-overlay"></div>
<nav id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <a href="/" class={isActive('/')}>Inicio</a>

  <div class="mobile-accordion">
    <button class="mobile-accordion-trigger" type="button" aria-expanded="false">
      Artículos
      <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div class="mobile-accordion-panel">
      <a href="/articulos">Todos los artículos</a>
      <a href="/articulos?categoria=Casos">Casos</a>
      <a href="/articulos?categoria=Entrevistas">Entrevistas</a>
      <a href="/articulos?categoria=Análisis">Análisis</a>
      <a href="/articulos?categoria=Podcast">Podcast</a>
    </div>
  </div>

  <a href="/arbitros" class={isActive('/arbitros')}>Árbitros</a>
  <a href="/entrenadores" class={isActive('/entrenadores')}>Entrenadores</a>
  <a href="/cursos" class={isActive('/cursos')}>Cursos</a>
  <a href="/sobre-nosotros" class={isActive('/sobre-nosotros')}>Sobre Nosotros</a>
</nav>

<script>
  function initHeader() {
    const header = document.querySelector('header.site-header');
    const toggle = document.querySelector('.menu-toggle');
    const menu = document.querySelector('.mobile-menu');
    const overlay = document.querySelector('.mobile-menu-overlay');
    const accordionTrigger = document.querySelector('.mobile-accordion-trigger');
    const accordion = document.querySelector('.mobile-accordion');

    const onScroll = () => {
      header?.classList.toggle('is-scrolled', window.scrollY > 12);
    };

    const closeMenu = () => {
      toggle?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Abrir menú');
      menu?.classList.remove('is-open');
      menu?.setAttribute('aria-hidden', 'true');
      overlay?.classList.remove('is-open');
      document.body.classList.remove('menu-open');
    };

    const openMenu = () => {
      toggle?.classList.add('is-open');
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Cerrar menú');
      menu?.classList.add('is-open');
      menu?.setAttribute('aria-hidden', 'false');
      overlay?.classList.add('is-open');
      document.body.classList.add('menu-open');
    };

    const onToggleClick = () => {
      toggle?.classList.contains('is-open') ? closeMenu() : openMenu();
    };

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeMenu();
    };

    const onAccordionClick = () => {
      const isOpen = accordion?.classList.toggle('is-open');
      accordionTrigger?.setAttribute('aria-expanded', String(!!isOpen));
    };

    const onResize = () => {
      if (window.innerWidth > 1100) closeMenu();
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    document.addEventListener('keydown', onKeydown);
    toggle?.addEventListener('click', onToggleClick);
    overlay?.addEventListener('click', closeMenu);
    accordionTrigger?.addEventListener('click', onAccordionClick);
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    // El header se reemplaza por completo en cada navegación del
    // ClientRouter, pero los listeners de scroll/resize/keydown quedan
    // colgados de window/document, que sí sobreviven. Los quitamos antes
    // de cada swap para no acumularlos ni apuntar a nodos ya removidos
    // (mismo patrón que en ReadingProgress.astro).
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        document.removeEventListener('keydown', onKeydown);
      },
      { once: true }
    );
  }

  // Se registra una sola vez, pero corre en cada carga: tanto la inicial
  // como cada navegación SPA disparan 'astro:page-load'.
  document.addEventListener('astro:page-load', initHeader);
</script>