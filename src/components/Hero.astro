---
---
<section class="hero">
  <div class="hero-bg-image" style="background-image: url('/hero-bg.png');"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <div class="eyebrow">
        <div class="rule"></div>
        <span>La Hora del Arbitraje</span>
      </div>

      <h1 class="hero-heading">
        <span class="line">Únete a la</span>
        <span class="accent">Comunidad</span>
        <span class="line">del Ajedrez Mundial</span>
      </h1>

      <p class="hero-copy">
        Noticias, entrevistas y análisis sobre arbitraje, integridad y el futuro del ajedrez competitivo — de la mano de <strong>Chess.com</strong>.
      </p>

      <div class="hero-features">
        <div class="hero-feature">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9s1.3-6.4 3.8-9z"/></svg>
          </div>
          <div class="hero-feature-text">
            <strong>Conecta</strong>
            <span>con millones de jugadores</span>
          </div>
        </div>

        <div class="hero-feature">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l2.2 2.6 3.3-.6.6 3.3L21 10l-2.9 1.7.6 3.3-3.3-.6L12 17l-2.4-2.6-3.3.6.6-3.3L4 10l2.9-1.7-.6-3.3 3.3.6L12 3z"/></svg>
          </div>
          <div class="hero-feature-text">
            <strong>Aprende</strong>
            <span>mejora tu juego cada día</span>
          </div>
        </div>

        <div class="hero-feature">
          <div class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><path d="M2 20c0-3 2.7-5.5 6-5.5s6 2.5 6 5.5M10 20c0-3 2.7-5.5 6-5.5s6 2.5 6 5.5"/></svg>
          </div>
          <div class="hero-feature-text">
            <strong>Crece</strong>
            <span>sé parte de la comunidad más grande del ajedrez</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
