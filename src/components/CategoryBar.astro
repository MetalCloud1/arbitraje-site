---
// Barra de navegación principal. Vive separada del header (que ahora es
// solo identidad de marca) y se muestra en todas las pantallas: en
// desktop como fila de enlaces, en mobile como una fila con scroll
// horizontal (ver .main-nav en global.css). Las subcategorías de Artículos
// se eligen con los chips de /articulos, en todas las pantallas.
import SearchBox from './SearchBox.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (path === href ? 'active' : '');
---
<div class="category-bar">
  <div class="container category-bar-inner">
    <nav class="main-nav" aria-label="Categorías principales">
      <a href="/" class={isActive('/')}>Inicio</a>
      <a href="/articulos" class={path.startsWith('/articulos') ? 'active' : ''}>Artículos</a>
      <a href="/arbitros" class={isActive('/arbitros')}>Árbitros</a>
      <a href="/entrenadores" class={isActive('/entrenadores')}>Entrenadores</a>
      <a href="/clubes" class={path.startsWith('/clubes') ? 'active' : ''}>Clubes</a>
      <a href="/sobre-nosotros" class={isActive('/sobre-nosotros')}>Sobre Nosotros</a>
    </nav>

    <SearchBox />
  </div>

  {/* Panel del menú hamburguesa (mobile). Vive dentro de .category-bar
      (no de .category-bar-inner) para no depender del layout del nav de
      escritorio; se muestra/oculta por completo con la clase
      body.mobile-nav-open que activa el botón de Header.astro. No
      reutiliza <SearchBox /> (que ya está arriba, con id fijo) para no
      duplicar ids en el documento -- en mobile el buscador es un form
      simple que manda directo a /articulos?buscar=. */}
  <div class="container">
    <nav id="mobile-nav-panel" class="mobile-nav-panel" aria-label="Menú de navegación">
      <form class="mobile-search-form" action="/articulos" method="get">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
        <input type="search" name="buscar" placeholder="Buscar artículos…" aria-label="Buscar artículos" autocomplete="off" />
      </form>

      <a href="/" class={`mobile-nav-link ${isActive('/')}`}>Inicio</a>
      <a href="/articulos" class={`mobile-nav-link ${path.startsWith('/articulos') ? 'active' : ''}`}>Artículos</a>
      <a href="/arbitros" class={`mobile-nav-link ${isActive('/arbitros')}`}>Árbitros</a>
      <a href="/entrenadores" class={`mobile-nav-link ${isActive('/entrenadores')}`}>Entrenadores</a>
      <a href="/clubes" class={`mobile-nav-link ${path.startsWith('/clubes') ? 'active' : ''}`}>Clubes</a>
      <a href="/sobre-nosotros" class={`mobile-nav-link ${isActive('/sobre-nosotros')}`}>Sobre Nosotros</a>
    </nav>
  </div>
</div>
