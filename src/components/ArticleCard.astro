---
import type { Article } from '../lib/db';
import { formatDateEs } from '../lib/text';
import { resolveThumbnail } from '../lib/video';
import MediaFrame from './MediaFrame.astro';

interface Props {
  article: Article;
  /**
   * Las view-transitions nombradas (portada + título) hacen que la tarjeta
   * "viaje" en una sola pieza hacia el detalle del artículo. Vale la pena en
   * grids chicos (home, destacados: 3-8 tarjetas), pero en /articulos, que
   * lista TODOS los artículos sin paginar, cada tarjeta suma 2 grupos de
   * view-transition más -- con muchos artículos, el navegador termina
   * rastreando decenas de grupos en cada entrada/salida de esa página, lo
   * que se siente como una transición lenta y, atrás, un reveal-stagger que
   * no llega a animarse con fluidez. Por eso /articulos pasa `false` acá.
   */
  enableTransitions?: boolean;
}

const { article, enableTransitions = true } = Astro.props;
const thumb = resolveThumbnail(article);
---
<article class="article-card">
  <a class="article-title-link" href={`/articulos/${article.slug}`}>
    <div class="article-thumb">
      <MediaFrame
        imageUrl={thumb.imageUrl}
        alt={article.title}
        isVideo={thumb.isVideo}
        transitionName={enableTransitions ? `article-cover-${article.slug}` : undefined}
      />
    </div>
  </a>
  <div class="article-category">{article.category}</div>
  <a class="article-title-link" href={`/articulos/${article.slug}`}>
    <h3 class="article-title" {...(enableTransitions ? { 'transition:name': `article-title-${article.slug}` } : {})}>{article.title}</h3>
  </a>
  <div class="article-meta">
    <span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      {formatDateEs(article.published_at)}
    </span>
    <span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
      {article.read_minutes} min
    </span>
  </div>
</article>