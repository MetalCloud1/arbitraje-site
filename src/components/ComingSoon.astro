---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="coming-soon reveal">
  <div class="coming-soon-icon" aria-hidden="true">
    <img
      src="/icons/knight.svg"
      alt=""
      width="56"
      height="56"
    />
  </div>

  <h1>{title}</h1>

  <p class="coming-soon-msg">
    Alguien despierte al desarrollador… esta sección todavía no está lista. ☕
  </p>

  <p class="coming-soon-sub">
    Estamos trabajando en esta sección. Vuelve pronto.
  </p>

  <a class="coming-soon-back" href="/articulos">
    Volver al tablero
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </a>
</div>