---
import { SITE_NAME, CONTACT_EMAIL, SOCIAL_LINKS } from '../lib/site';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">{SITE_NAME}</p>
        <p class="footer-tagline">
          Noticias, análisis y cobertura de ajedrez, con el arbitraje y el juego limpio como sello propio.
        </p>
        <div class="footer-social">
          <a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer" aria-label={`${SITE_NAME} en Facebook`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.505 17.523 2 12 2S2 6.505 2 12.06c0 5.02 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.476h-1.26c-1.243 0-1.63.775-1.63 1.57v1.888h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.92 8.437-9.94Z"/></svg>
          </a>
          <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" aria-label={`${SITE_NAME} en YouTube`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M21.582 7.186a2.51 2.51 0 0 0-1.768-1.778C18.254 5 12 5 12 5s-6.254 0-7.814.408a2.51 2.51 0 0 0-1.768 1.778C2 8.756 2 12 2 12s0 3.244.418 4.814a2.51 2.51 0 0 0 1.768 1.778C5.746 19 12 19 12 19s6.254 0 7.814-.408a2.51 2.51 0 0 0 1.768-1.778C22 15.244 22 12 22 12s0-3.244-.418-4.814ZM10 15.5v-7l6 3.5-6 3.5Z"/></svg>
          </a>
        </div>
      </div>

      <nav class="footer-col" aria-label="Explorar">
        <p class="footer-heading">Explorar</p>
        <a href="/articulos">Artículos</a>
        <a href="/arbitros">Árbitros</a>
        <a href="/entrenadores">Entrenadores</a>
      </nav>

      <nav class="footer-col" aria-label="El sitio">
        <p class="footer-heading">El sitio</p>
        <a href="/sobre-nosotros">Sobre Nosotros</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>Contacto</a>
        <a href="/rss.xml">RSS</a>
      </nav>

      <nav class="footer-col" aria-label="Legal">
        <p class="footer-heading">Legal</p>
        <a href="/politica-de-privacidad">Política de Privacidad</a>
        <a href="/terminos-y-condiciones">Términos y Condiciones</a>
      </nav>
    </div>

    <p class="footer-legal">© {year} {SITE_NAME}. Todos los derechos reservados.</p>
  </div>
</footer>
