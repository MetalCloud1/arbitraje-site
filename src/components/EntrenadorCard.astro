---
// Tarjeta de grilla, no fila: a diferencia de árbitros (donde el título es
// casi el único dato), acá el título Y el ELO tienen que "pesar" visualmente,
// así que necesitan más aire del que da una fila angosta. Sirve tanto para
// el registro completo (admin) como para el resumen liviano del directorio
// paginado -- mismo patrón que ArbitroRow.
import { getTituloAjedrezTier, formatElo } from '../lib/titulos-ajedrez';
import { getTituloTier } from '../lib/postulacion';
import QueenMark from './QueenMark.astro';

interface EntrenadorCardData {
  slug: string;
  nombre_completo: string;
  estado_republica: string | null;
  titulo_ajedrez: string | null;
  titulo_arbitraje: string | null;
  elo_clasico: number | null;
  foto_key: string | null;
}

interface Props {
  entrenador: EntrenadorCardData;
}

const { entrenador } = Astro.props;
const fotoUrl = entrenador.foto_key ? `/api/img/${entrenador.foto_key}` : null;
const tierAjedrez = getTituloAjedrezTier(entrenador.titulo_ajedrez);
const tierArbitraje = entrenador.titulo_arbitraje ? getTituloTier(entrenador.titulo_arbitraje) : null;
const photoStyle = `--tier-color:${tierAjedrez.color}; --tier-color-bright:${tierAjedrez.colorBright}; --tier-glow:${tierAjedrez.glow}`;
---
<a class="entrenador-card" href={`/entrenadores/${entrenador.slug}`}>
  <div class="entrenador-card-photo" data-tier={tierAjedrez.tier} style={photoStyle} transition:name={`entrenador-photo-${entrenador.slug}`}>
    {fotoUrl ? (
      <img
        src={fotoUrl}
        alt={entrenador.nombre_completo}
        loading="lazy"
        onerror="this.style.display='none';this.nextElementSibling.style.display='';"
      />
    ) : null}
    <QueenMark class="entrenador-card-queen" style={fotoUrl ? { display: 'none' } : undefined} />
    {tierAjedrez.short && <span class="entrenador-card-rank" aria-hidden="true">{tierAjedrez.short}</span>}
  </div>

  <div class="entrenador-card-body">
    <h3 class="entrenador-card-name" transition:name={`entrenador-name-${entrenador.slug}`}>{entrenador.nombre_completo}</h3>

    <div class="entrenador-card-titles">
      {entrenador.titulo_ajedrez && (
        <span class="entrenador-card-badge" style={`color:${tierAjedrez.colorBright}; border-color:${tierAjedrez.color}`}>
          {entrenador.titulo_ajedrez}
        </span>
      )}
      {tierArbitraje && (
        <span class="entrenador-card-badge entrenador-card-badge-arbitraje" style={`color:${tierArbitraje.color}`}>
          {entrenador.titulo_arbitraje}
        </span>
      )}
    </div>

    <div class="entrenador-card-elo">
      <span class="entrenador-card-elo-value">{formatElo(entrenador.elo_clasico)}</span>
      <span class="entrenador-card-elo-label">ELO clásico</span>
    </div>

    {entrenador.estado_republica && (
      <div class="entrenador-card-location">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>
        </svg>
        {entrenador.estado_republica}
      </div>
    )}
  </div>

  <span class="entrenador-card-cta" aria-hidden="true">
    Ver perfil
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
  </span>
</a>
