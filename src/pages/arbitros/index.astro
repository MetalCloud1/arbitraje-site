---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listArbitrosPage, countArbitros, listEstadosConArbitros } from '../../lib/arbitros';
import { TITULOS_ARBITRO } from '../../lib/postulacion';
import ArbitroRow from '../../components/ArbitroRow.astro';
import EmptyState from '../../components/EmptyState.astro';

export const prerender = false;

const PAGE_SIZE = 5;

const db = Astro.locals.runtime.env.DB;
const estadoFiltro = Astro.url.searchParams.get('estado');
const tituloFiltro = Astro.url.searchParams.get('titulo');

const [{ items: arbitros, nextCursor }, total, estados] = await Promise.all([
  listArbitrosPage(db, { estado: estadoFiltro, titulo: tituloFiltro, limit: PAGE_SIZE }),
  countArbitros(db),
  listEstadosConArbitros(db),
]);

const descripcion = `El directorio nacional de árbitros de ajedrez en América. ${total} árbitros registrados.`;
---
<BaseLayout
  title="Árbitros - La Hora del Arbitraje"
  description="Directorio de árbitros de ajedrez en América: perfiles verificados y visibilidad para quienes arbitran."
>
  <div class="container arbitros-page">
    <div class="arbitros-header">
      <div class="arbitros-header-copy">
        <h1>Árbitros</h1>
        <p class="arbitros-intro">{descripcion}</p>
      </div>
      <a class="btn btn-primary arbitros-cta" href="/postular?tipo=arbitro">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Registrarme como árbitro
      </a>
    </div>

    <div class="arbitros-controls">
      <div class="arbitros-search-wrap">
        <svg class="arbitros-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" />
        </svg>
        <input
          type="search"
          class="arbitros-search-input"
          data-arbitros-search-input
          placeholder="Buscar árbitro por nombre, título o estado…"
          aria-label="Buscar árbitro"
          autocomplete="off"
        />
      </div>
      <select class="arbitros-select" data-arbitros-titulo-select aria-label="Filtrar por categoría">
        <option value="">Todas las categorías</option>
        {TITULOS_ARBITRO.map((t) => <option value={t} selected={tituloFiltro === t}>{t}</option>)}
      </select>
    </div>

    {estados.length > 0 && (
      <div class="arbitros-filtros-wrap">
        <div class="arbitros-filtros">
          <a class={`filtro-chip ${!estadoFiltro ? 'active' : ''}`} href="/arbitros">Todos</a>
          {estados.map((e) => (
            <a class={`filtro-chip ${estadoFiltro === e ? 'active' : ''}`} href={`/arbitros?estado=${encodeURIComponent(e)}`}>{e}</a>
          ))}
        </div>
      </div>
    )}

    <div
      class="arbitros-root"
      data-arbitros-root
      data-estado={estadoFiltro ?? ''}
      data-titulo={tituloFiltro ?? ''}
      data-cursor={nextCursor ?? ''}
    >
      {arbitros.length === 0 ? (
        <EmptyState
          title={estadoFiltro || tituloFiltro ? 'Ningún árbitro registrado con ese filtro todavía' : 'Todavía no hay árbitros registrados'}
          description="¿Eres árbitro y quieres aparecer acá?"
          actionLabel="Registrarme como árbitro"
          actionHref="/postular?tipo=arbitro"
        />
      ) : (
        <div class="arbitros-list reveal-stagger" data-arbitros-list>
          {arbitros.map((a) => <ArbitroRow arbitro={a} />)}
        </div>
      )}
      <div class="arbitros-sentinel" data-arbitros-sentinel>
        <div class="arbitros-loading" data-arbitros-loading hidden>
          <span class="arbitros-loading-dot"></span>
          <span class="arbitros-loading-dot"></span>
          <span class="arbitros-loading-dot"></span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // ---------- Filas de árbitro por JS (mismos datos que ArbitroRow.astro) ----------
  // Mantener esto en sync con getTituloTier() en src/lib/postulacion.ts.
  const TIER_BY_TITULO: Record<string, { color: string }> = {
    'Árbitro Internacional (AI)': { color: '#e3b341' },
    'Árbitro FIDE (FA)': { color: '#c7d0d6' },
    'Árbitro Nacional (AN)': { color: '#c17f4a' },
    'Árbitro de Club': { color: '#81b64c' },
    'En formación / Sin título': { color: '#7c8a80' },
  };
  const DEFAULT_TIER = TIER_BY_TITULO['En formación / Sin título'];
  const getTier = (titulo: string | null) => (titulo && TIER_BY_TITULO[titulo]) || DEFAULT_TIER;

  const PAWN_SVG = `<svg class="pawn-mark arbitro-row-pawn" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path d="M27.78,16.0353a6.3866,6.3866,0,1,0-7.559,0" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M27.7791,16.0348,32.31,19.0181a8.4613,8.4613,0,0,1-.7678,2.6175H16.4579a8.4613,8.4613,0,0,1-.7678-2.6175l4.5308-2.9833" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M27.5287,21.6356c0,9.0738,9.3879,10.4,9.3879,19.1946-1.745,2.19-7.93,2.67-12.9166,2.67s-11.1716-.4794-12.9166-2.67c0-8.7946,9.3879-10.1208,9.3879-19.1946" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>`;

  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  }

  interface ArbitroResumen {
    id: number;
    slug: string;
    nombre_completo: string;
    estado_republica: string | null;
    titulo: string | null;
    foto_key: string | null;
  }

  function rowHtml(a: ArbitroResumen): string {
    const tier = getTier(a.titulo);
    // Ojo: NO usar encodeURIComponent sobre foto_key completo -- convierte la
    // "/" de "arbitros/archivo.webp" en "%2F" y la ruta catch-all /api/img/[...key]
    // ya no matchea la key real en R2 (404). Iba sin codificar en el componente
    // Astro y así se queda acá también.
    const fotoUrl = a.foto_key ? `/api/img/${a.foto_key}` : null;
    return `
      <a class="arbitro-row" href="/arbitros/${encodeURIComponent(a.slug)}">
        <div class="arbitro-row-photo">
          ${fotoUrl ? `<img src="${fotoUrl}" alt="${escapeHtml(a.nombre_completo)}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='';" />` : ''}
          ${PAWN_SVG.replace('<svg ', fotoUrl ? '<svg style="display:none" ' : '<svg ')}
        </div>
        <div class="arbitro-row-main">
          <h3 class="arbitro-row-name">${escapeHtml(a.nombre_completo)}</h3>
          ${a.titulo ? `<div class="arbitro-row-titulo" style="color:${tier.color}">${escapeHtml(a.titulo)}</div>` : ''}
        </div>
        ${a.estado_republica ? `
          <div class="arbitro-row-location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>
            </svg>
            ${escapeHtml(a.estado_republica)}
          </div>` : ''}
        <span class="arbitro-row-cta" aria-hidden="true">
          <span>Ver perfil</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
        </span>
      </a>`;
  }

  const PAGE_SIZE = 5;
  const MIN_QUERY_LENGTH = 2;
  const DEBOUNCE_MS = 300;

  function initArbitrosPage(root: Element) {
    if (root.getAttribute('data-arbitros-bound') === 'true') return;
    root.setAttribute('data-arbitros-bound', 'true');

    const searchInput = document.querySelector('[data-arbitros-search-input]');
    const tituloSelect = document.querySelector('[data-arbitros-titulo-select]');
    const sentinel = root.querySelector('[data-arbitros-sentinel]');
    const loadingEl = root.querySelector('[data-arbitros-loading]');
    if (!(sentinel instanceof HTMLElement) || !(loadingEl instanceof HTMLElement)) return;

    const estado = root.getAttribute('data-estado') || '';
    let titulo = root.getAttribute('data-titulo') || '';
    let cursor = root.getAttribute('data-cursor') || '';
    let query = '';
    let loading = false;
    let requestId = 0;

    const ensureList = (): HTMLElement => {
      const existing = root.querySelector('[data-arbitros-list]');
      if (existing instanceof HTMLElement) return existing;
      const el = document.createElement('div');
      el.className = 'arbitros-list reveal-stagger is-visible';
      el.setAttribute('data-arbitros-list', '');
      root.insertBefore(el, sentinel);
      return el;
    };

    const showEmpty = () => {
      const existing = root.querySelector('[data-arbitros-list]');
      existing?.remove();
      let empty = root.querySelector('[data-arbitros-empty]');
      if (!empty) {
        empty = document.createElement('div');
        empty.setAttribute('data-arbitros-empty', '');
        empty.className = 'empty-state';
        root.insertBefore(empty, sentinel);
      }
      empty.innerHTML = `
        <p class="empty-state-title">Sin resultados${query ? ` para “${escapeHtml(query)}”` : ''}</p>
        <p class="empty-state-description">Probá con otro nombre, título, categoría o estado.</p>`;
    };

    const clearEmpty = () => root.querySelector('[data-arbitros-empty]')?.remove();

    const fetchPage = async (reset: boolean) => {
      if (loading) return;
      if (!reset && !cursor) return;
      loading = true;
      loadingEl.hidden = false;
      const myRequestId = ++requestId;

      const params = new URLSearchParams({ limit: String(PAGE_SIZE) });
      if (estado) params.set('estado', estado);
      if (titulo) params.set('titulo', titulo);
      if (query.length >= MIN_QUERY_LENGTH) params.set('q', query);
      if (!reset && cursor) params.set('cursor', cursor);

      try {
        const res = await fetch(`/api/arbitros/directorio?${params.toString()}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: { items: ArbitroResumen[]; nextCursor: string | null } = await res.json();
        if (myRequestId !== requestId) return; // respuesta obsoleta (llegó otra búsqueda/filtro después)

        cursor = data.nextCursor || '';

        if (reset && data.items.length === 0) {
          showEmpty();
        } else {
          clearEmpty();
          const listEl = ensureList();
          if (reset) listEl.innerHTML = '';
          listEl.insertAdjacentHTML('beforeend', data.items.map(rowHtml).join(''));
        }

        // El observer solo avisa en un cambio de estado (pasa de "no
        // visible" a "visible"), no mientras el target se queda quieto en
        // estado visible. En pantallas anchas las filas son más bajas (todo
        // entra en una sola línea), así que una página de 5 puede no
        // alcanzar a empujar el sentinel fuera de la zona observada
        // (viewport + rootMargin) -- nunca vuelve a "entrar" porque nunca
        // llegó a "salir", y el observer se queda callado para siempre
        // aunque queden más árbitros. En pantallas angostas las filas
        // ocupan más alto (el título, ELO y ubicación se apilan) y esto no
        // pasa, por eso el bug solo se veía en escritorio. Acá forzamos una
        // re-evaluación: si el sentinel sigue a tiro después de insertar,
        // seguimos pidiendo páginas hasta que ya no lo esté o se acabe el cursor.
        if (cursor) {
          requestAnimationFrame(() => {
            if (loading || !cursor) return;
            const rect = sentinel.getBoundingClientRect();
            if (rect.top <= window.innerHeight + 400) fetchPage(false);
          });
        }
      } catch {
        if (myRequestId !== requestId) return;
        loadingEl.hidden = true;
        // Silencioso: si falla la carga de "más", el usuario simplemente
        // no ve nuevas filas; el listado ya cargado sigue intacto.
      } finally {
        if (myRequestId === requestId) {
          loading = false;
          loadingEl.hidden = true;
        }
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !loading && cursor) fetchPage(false);
        }
      },
      { rootMargin: '400px 0px' }
    );
    io.observe(sentinel);

    if (searchInput instanceof HTMLInputElement) {
      let debounceTimer: ReturnType<typeof setTimeout> | null = null;
      searchInput.addEventListener('input', () => {
        const value = searchInput.value.trim();
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          if (value.length > 0 && value.length < MIN_QUERY_LENGTH) return;
          query = value;
          fetchPage(true);
        }, DEBOUNCE_MS);
      });
    }

    if (tituloSelect instanceof HTMLSelectElement) {
      tituloSelect.addEventListener('change', () => {
        titulo = tituloSelect.value;
        fetchPage(true);
      });
    }
  }

  function initAllArbitrosPages() {
    document.querySelectorAll('[data-arbitros-root]').forEach(initArbitrosPage);
  }

  document.addEventListener('astro:page-load', initAllArbitrosPages);
</script>

<script>
  // Reveal de la lista inicial (renderizada por el servidor). Igual que
  // antes: casi siempre visible al cargar, pero via IntersectionObserver
  // por si algún día hay contenido arriba. Reengancha en cada navegación.
  function initArbitrosReveal() {
    const list = document.querySelector('.arbitros-list.reveal-stagger:not(.is-visible)');
    if (!list || list.getAttribute('data-reveal-bound') === 'true') return;
    list.setAttribute('data-reveal-bound', 'true');

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08 }
    );
    io.observe(list);
  }

  document.addEventListener('astro:page-load', initArbitrosReveal);
</script>