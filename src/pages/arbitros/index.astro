---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArbitroCard from '../../components/ArbitroCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { formatDateEs } from '../../lib/text';
import { listArticlesByCategory } from '../../lib/db';
import { listArbitrosPage, countArbitros } from '../../lib/arbitros';

export const prerender = false;

// Vista previa liviana de cada bloque: el contenido completo vive en sus
// propias rutas (/articulos?categoria=..., /arbitros/directorio, /formacion).
// Este hub es la portada de la sección, no un listado más.
const COMUNIDAD_PREVIEW = 5;
const ACTIVIDAD_PREVIEW = 3;
const AVISOS_PREVIEW = 3;

const db = env.DB;
const [{ items: comunidad }, totalArbitros, actividad, avisos] = await Promise.all([
  listArbitrosPage(db, { limit: COMUNIDAD_PREVIEW }),
  countArbitros(db),
  listArticlesByCategory(db, 'Actividad Arbitral', ACTIVIDAD_PREVIEW),
  listArticlesByCategory(db, 'Avisos', AVISOS_PREVIEW),
]);

const destacado = comunidad[0] ?? null;
const resto = comunidad.slice(1, 5);
---
<BaseLayout
  title="Árbitros - La Hora del Arbitraje"
  description="Comunidad, actividad profesional y formación de árbitros de ajedrez en América."
>
  <section class="arbitros-hero">
    <img class="arbitros-hero-img" src="/arbitros-hero.webp" alt="Árbitros de ajedrez de América reunidos en una convención internacional" />
    <div class="arbitros-hero-scrim" aria-hidden="true"></div>
    <div class="container arbitros-hero-content">
      <p class="arbitros-hero-eyebrow">La Hora del Arbitraje · América</p>
      <h1>El arbitraje <em>nos une.</em></h1>
      <p class="arbitros-hero-sub">
        Un espacio para la comunidad, la actividad profesional y la formación de los árbitros
        de ajedrez en América, hecho desde la colaboración entre quienes arbitran cada día.
      </p>
    </div>
  </section>

  <section class="hub-section" id="comunidad">
    <div class="container hub-section-grid">
      <div class="hub-section-copy">
        <span class="hub-section-num">01</span>
        <h2>Comunidad</h2>
        <p class="hub-section-tagline">Los rostros del arbitraje</p>
        <p class="hub-section-desc">
          Conoce a los árbitros que hacen posible el ajedrez en América. Sus perfiles,
          trayectorias y títulos, en un directorio abierto a toda la comunidad.
        </p>
        <a class="hub-link-btn" href="/arbitros/directorio">
          Explorar perfiles
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="hub-section-subtle-link" href="/postular?tipo=arbitro">¿Eres árbitro? Regístrate en el directorio</a>
      </div>

      {comunidad.length > 0 ? (
        <div class="arbitros-bento">
          {destacado && <ArbitroCard arbitro={destacado} featured />}
          {resto.length > 0 && (
            <div class="arbitros-bento-rest">
              {resto.map((a) => <ArbitroCard arbitro={a} />)}
            </div>
          )}
        </div>
      ) : (
        <EmptyState
          title="Todavía no hay árbitros registrados"
          description="¿Eres árbitro y quieres aparecer acá?"
          actionLabel="Registrarme como árbitro"
          actionHref="/postular?tipo=arbitro"
        />
      )}
    </div>
  </section>

  <section class="hub-section hub-section-alt" id="actividad">
    <div class="container hub-section-grid">
      <div class="hub-section-copy">
        <span class="hub-section-num">02</span>
        <h2>Actividad profesional</h2>
        <p class="hub-section-tagline">El arbitraje en acción</p>
        <p class="hub-section-desc">
          Designaciones, resultados y trayectoria de nuestros árbitros, además de
          convocatorias y seminarios para quienes buscan la próxima oportunidad.
        </p>
        <a class="hub-link-btn" href="/articulos?categoria=Actividad%20Arbitral">
          Ver toda la actividad
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="hub-mini-lists">
        <div class="hub-mini-list">
          <h3>Actividad</h3>
          {actividad.length > 0 ? (
            <ul>
              {actividad.map((a) => (
                <li>
                  <a href={`/articulos/${a.slug}`}>
                    <span class="hub-mini-item-title">{a.title}</span>
                    <span class="hub-mini-item-date">{formatDateEs(a.published_at)}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="hub-mini-empty">Todavía no hay actividad publicada.</p>
          )}
        </div>

        <div class="hub-mini-list">
          <h3>Avisos</h3>
          {avisos.length > 0 ? (
            <ul>
              {avisos.map((a) => (
                <li>
                  <a href={`/articulos/${a.slug}`}>
                    <span class="hub-mini-item-title">{a.title}</span>
                    <span class="hub-mini-item-date">{formatDateEs(a.published_at)}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="hub-mini-empty">Todavía no hay avisos publicados.</p>
          )}
          <a class="hub-mini-list-link" href="/articulos?categoria=Avisos">Ver todos los avisos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hub-section" id="formacion">
    <div class="container hub-section-grid">
      <div class="hub-section-copy">
        <span class="hub-section-num">03</span>
        <h2>Formación</h2>
        <p class="hub-section-tagline">El conocimiento que nos prepara</p>
        <p class="hub-section-desc">
          La ruta para formarse como árbitro y los recursos oficiales para empezar
          a construir criterio arbitral desde hoy.
        </p>
        <a class="hub-link-btn" href="/formacion">
          Explorar formación
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <ul class="hub-icon-list">
        <li>
          <a href="/formacion#recursos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
            Reglamentos y leyes del ajedrez
          </a>
        </li>
        <li>
          <a href="/articulos?categoria=Casos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 4v16"/></svg>
            Casos prácticos de arbitraje
          </a>
        </li>
        <li>
          <a href="/formacion#ruta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>
            La ruta de titulación, paso a paso
          </a>
        </li>
        <li>
          <a href="/formacion#recursos">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
            Recursos oficiales de la FIDE
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .arbitros-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .arbitros-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .arbitros-hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg-black) 0%, rgba(10, 20, 16, 0.55) 55%, rgba(10, 20, 16, 0.25) 100%);
  }
  .arbitros-hero-content {
    position: relative;
    padding-top: 2.5rem;
    padding-bottom: 2.75rem;
    max-width: 720px;
  }
  .arbitros-hero-eyebrow {
    color: var(--green-bright);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .arbitros-hero-content h1 {
    color: var(--white);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.08;
    margin-bottom: 0.9rem;
  }
  .arbitros-hero-content h1 em {
    color: var(--green-bright);
    font-style: normal;
  }
  .arbitros-hero-sub {
    color: var(--gray);
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 58ch;
    margin-bottom: 0;
  }

  /* ---------- Secciones numeradas ---------- */
  .hub-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .hub-section-alt {
    background: rgba(255, 255, 255, 0.015);
  }
  .hub-section:last-of-type {
    border-bottom: none;
  }

  .hub-section-grid {
    display: grid;
    grid-template-columns: minmax(260px, 380px) 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .hub-section-num {
    display: block;
    color: var(--green);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    margin-bottom: 0.6rem;
  }
  .hub-section-copy h2 {
    color: var(--white);
    font-size: 1.9rem;
    margin-bottom: 0.35rem;
  }
  .hub-section-tagline {
    color: var(--green-bright);
    font-weight: 600;
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .hub-section-desc {
    color: var(--gray);
    line-height: 1.6;
    margin-bottom: 1.4rem;
  }

  .hub-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 999px;
    border: 1px solid var(--green);
    color: var(--green-bright);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-interactive), color var(--dur-fast) var(--ease-interactive);
  }
  .hub-link-btn:hover {
    background: var(--green);
    color: #0a1410;
  }

  .hub-section-subtle-link {
    display: block;
    margin-top: 1rem;
    color: var(--gray-dim);
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .hub-section-subtle-link:hover {
    color: var(--gray);
  }

  /* ---------- Bento de Comunidad ---------- */
  .arbitros-bento {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 12px;
  }
  .arbitros-bento-rest {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  /* ---------- Mini listas de Actividad/Avisos ---------- */
  .hub-mini-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .hub-mini-list {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
  }
  .hub-mini-list h3 {
    color: var(--white);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .hub-mini-list ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .hub-mini-list li a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
  }
  .hub-mini-item-title {
    color: var(--white);
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .hub-mini-list li a:hover .hub-mini-item-title {
    color: var(--green-bright);
  }
  .hub-mini-item-date {
    color: var(--gray-dim);
    font-size: 0.78rem;
  }
  .hub-mini-empty {
    color: var(--gray-dim);
    font-size: 0.85rem;
  }
  .hub-mini-list-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--gray);
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---------- Lista de íconos de Formación ---------- */
  .hub-icon-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .hub-icon-list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--white);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-interactive);
  }
  .hub-icon-list a:hover {
    border-color: var(--green);
  }
  .hub-icon-list svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--green-bright);
  }

  @media (max-width: 600px) {
    /* Más aire que el .container estándar (24px): acá el texto es lo único
       en pantalla, así que pegarlo a los 24px de siempre se siente más
       apretado que en una grilla con más elementos alrededor. */
    .arbitros-hero-content {
      padding-left: 32px;
      padding-right: 32px;
    }
  }

  @media (max-width: 860px) {
    .arbitros-hero {
      min-height: 420px;
    }
    .hub-section-grid {
      grid-template-columns: 1fr;
    }
    .hub-mini-lists,
    .hub-icon-list {
      grid-template-columns: 1fr;
    }
    .arbitros-bento {
      grid-template-columns: 1fr;
    }
  }
</style>
