---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArbitroById } from '../../lib/arbitros';
import { ESTADOS_MX, TITULOS_ARBITRO } from '../../lib/postulacion';

export const prerender = false;

const env = Astro.locals.runtime.env;
const TURNSTILE_SITE_KEY = env.PUBLIC_TURNSTILE_SITE_KEY;

const enviado = Astro.url.searchParams.get('enviado') === '1';
const error = Astro.url.searchParams.get('error');

const reclamoIdRaw = Astro.url.searchParams.get('reclamo');
const reclamoId = reclamoIdRaw ? Number(reclamoIdRaw) : null;
const arbitroReclamado =
  reclamoId && Number.isInteger(reclamoId) && reclamoId > 0 ? await getArbitroById(env.DB, reclamoId) : null;

// Si viene un ?reclamo=ID que no corresponde a ningún perfil, no tiene
// sentido mostrar el formulario en "modo reclamo" de un perfil
// inexistente -- lo tratamos como registro normal.
const esReclamo = !!arbitroReclamado;
---
<BaseLayout
  title={esReclamo ? `Reclamar perfil de ${arbitroReclamado!.nombre_completo} - La Hora del Arbitraje` : 'Registrarme como árbitro - La Hora del Arbitraje'}
  noindex
>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="container postular-page">
    <a class="back-link" href="/arbitros">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Volver a árbitros
    </a>

    <h1>{esReclamo ? 'Reclamar perfil' : 'Registrarme como árbitro'}</h1>

    {esReclamo ? (
      <p class="postular-intro">
        Estás reclamando el perfil de <strong>{arbitroReclamado!.nombre_completo}</strong>. Completa el
        formulario para confirmar que eres tú: un humano revisa cada solicitud antes de aprobarla.
      </p>
    ) : (
      <p class="postular-intro">
        Este formulario no publica tu perfil automáticamente: la información llega a un humano que la
        revisa antes de sumarte al directorio.
      </p>
    )}

    {enviado && (
      <div class="alert alert-success">
        Tu {esReclamo ? 'reclamo' : 'postulación'} fue enviado. Te contactaremos por correo si hace falta algo más.
      </div>
    )}
    {error && <div class="alert alert-error">{error}</div>}

    {!enviado && (
      <form class="form-card" method="POST" action="/api/postular-arbitro">
        <input type="hidden" name="tipo" value={esReclamo ? 'reclamo' : 'registro'} />
        {esReclamo && <input type="hidden" name="arbitro_id" value={arbitroReclamado!.id} />}

        {/* Honeypot: invisible para una persona, tentador para un bot que
            autocompleta cualquier input que "parezca" un campo de contacto.
            Si llega lleno, el backend lo trata como spam sin decirlo. */}
        <div class="hp-field" aria-hidden="true">
          <label for="sitio_web">Sitio web</label>
          <input type="text" id="sitio_web" name="sitio_web" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field">
          <label for="nombre_completo">Nombre completo</label>
          <input
            type="text"
            id="nombre_completo"
            name="nombre_completo"
            required
            minlength="3"
            maxlength="100"
            pattern="[A-Za-zÀ-ÖØ-öø-ÿÑñ' -]{3,100}"
            title="Solo letras y espacios, sin números ni símbolos."
            value={esReclamo ? arbitroReclamado!.nombre_completo : ''}
          />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="estado">Estado</label>
            <select id="estado" name="estado" required>
              <option value="" disabled selected={!arbitroReclamado?.estado_republica}>Selecciona tu estado</option>
              {ESTADOS_MX.map((e) => (
                <option value={e} selected={arbitroReclamado?.estado_republica === e}>{e}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="titulo">Título</label>
            <select id="titulo" name="titulo" required>
              <option value="" disabled selected={!arbitroReclamado?.titulo}>Selecciona tu título</option>
              {TITULOS_ARBITRO.map((t) => (
                <option value={t} selected={arbitroReclamado?.titulo === t}>{t}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="fide_id">ID de FIDE (opcional)</label>
            <input
              type="text"
              id="fide_id"
              name="fide_id"
              inputmode="numeric"
              maxlength="10"
              pattern="[0-9]{4,10}"
              title="Solo números, entre 4 y 10 dígitos."
              value={arbitroReclamado?.fide_id ?? ''}
            />
          </div>
          <div class="field">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" required maxlength="254" value={arbitroReclamado?.email ?? ''} />
          </div>
        </div>

        <div class="field">
          <label for="bio">Breve descripción de tu carrera y trayectoria</label>
          <textarea
            id="bio"
            name="bio"
            required
            minlength="20"
            maxlength="1000"
            rows="5"
            data-char-counter
          >{arbitroReclamado?.bio ?? ''}</textarea>
          <p class="field-hint"><span data-char-count>0</span>/1000 caracteres</p>
        </div>

        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-action="postular_arbitro" data-theme="dark"></div>

        <p class="postular-ip-notice">
          Tu IP se subirá de forma automática junto con tu formulario, como parte de la revisión antispam.
        </p>

        <div class="row-actions">
          <button class="btn btn-primary" type="submit">Enviar {esReclamo ? 'reclamo' : 'postulación'}</button>
        </div>
      </form>
    )}
  </div>

  <script>
    // Contador de caracteres de la bio -- puramente cosmético, la
    // validación real (min/max/formato) siempre corre en el servidor.
    document.querySelectorAll('[data-char-counter]').forEach((el) => {
      if (!(el instanceof HTMLTextAreaElement)) return;
      const counter = el.parentElement?.querySelector('[data-char-count]');
      const update = () => {
        if (counter) counter.textContent = String(el.value.length);
      };
      el.addEventListener('input', update);
      update();
    });

    document.addEventListener('submit', (event) => {
      if (event.defaultPrevented) return;
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      const submitBtn = form.querySelector('button[type="submit"]');
      if (!(submitBtn instanceof HTMLButtonElement) || submitBtn.disabled) return;
      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');
      submitBtn.setAttribute('aria-busy', 'true');
    });
  </script>
</BaseLayout>
