---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getClubById, diasImparteToArray } from '../../../../lib/clubes';
import { PAISES_CLUBES } from '../../../../lib/paises';
import { DIAS_SEMANA, MODALIDADES } from '../../../../lib/clubes';

export const prerender = false;

const db = env.DB;
const id = Number(Astro.params.id);
const club = Number.isInteger(id) ? await getClubById(db, id) : null;

if (!club) {
  return Astro.redirect('/admin/clubes?error=' + encodeURIComponent('Club no encontrado.'));
}

const error = Astro.url.searchParams.get('error');
const logoUrl = club.logo_key ? `/api/img/${club.logo_key}` : null;
const diasActuales = diasImparteToArray(club.dias_imparte);
---
<AdminLayout title={`Editar — ${club.nombre}`}>
  <div class="admin-header">
    <h1>Editar club</h1>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form class="form-card" method="POST" action={`/api/clubes/${club.id}`} enctype="multipart/form-data">
    <div class="field">
      <label for="nombre">Nombre del club</label>
      <input type="text" id="nombre" name="nombre" required maxlength="120" value={club.nombre} />
    </div>

    <div class="field-row">
      <div class="field">
        <label for="pais">País</label>
        <select id="pais" name="pais" required>
          {PAISES_CLUBES.map((p) => <option value={p} selected={club.pais === p}>{p}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="modalidad">Modalidad</label>
        <select id="modalidad" name="modalidad">
          {MODALIDADES.map((m) => <option value={m.value} selected={club.modalidad === m.value}>{m.label}</option>)}
        </select>
      </div>
    </div>

    <div class="field">
      <label for="direccion">Dirección (estado/provincia, ciudad, calle)</label>
      <input type="text" id="direccion" name="direccion" maxlength="300" value={club.direccion ?? ''} />
    </div>

    <div class="field">
      <label>Días que imparten clases</label>
      <div class="dias-checkboxes">
        {DIAS_SEMANA.map((d) => (
          <label class="dia-checkbox">
            <input type="checkbox" name="dias" value={d} checked={diasActuales.includes(d)} />
            {d}
          </label>
        ))}
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="telefono">Teléfono (opcional)</label>
        <input type="tel" id="telefono" name="telefono" maxlength="20" value={club.telefono ?? ''} />
      </div>
      <div class="field">
        <label for="whatsapp">WhatsApp (opcional)</label>
        <input type="tel" id="whatsapp" name="whatsapp" maxlength="20" value={club.whatsapp ?? ''} />
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="email">Correo de contacto (opcional)</label>
        <input type="email" id="email" name="email" maxlength="254" value={club.email ?? ''} />
      </div>
      <div class="field">
        <label for="sitio_web">Sitio web o red social (opcional)</label>
        <input type="url" id="sitio_web" name="sitio_web" maxlength="300" value={club.sitio_web ?? ''} />
      </div>
    </div>

    <div class="field">
      <label for="bio">Descripción del club</label>
      <textarea id="bio" name="bio" rows="5" maxlength="1000">{club.bio ?? ''}</textarea>
    </div>

    <div class="field">
      <label for="logo">Logo</label>
      {logoUrl && <img class="cover-preview club-logo-preview" src={logoUrl} alt={club.nombre} />}
      <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" style="margin-top:10px;" />
      <p class="field-hint">Sube un nuevo logo para reemplazar el actual. Se recorta a un círculo en el directorio.</p>
      {logoUrl && (
        <label style="display:flex; align-items:center; gap:8px; margin-top:10px; font-weight:400;">
          <input type="checkbox" name="remove_logo" style="width:auto;" />
          Quitar el logo actual
        </label>
      )}
    </div>

    <div class="field-row">
      <div class="field">
        <label for="actividad">Actividad</label>
        <select id="actividad" name="actividad">
          <option value="activo" selected={club.actividad === 'activo'}>Activo</option>
          <option value="inactivo" selected={club.actividad === 'inactivo'}>Inactivo</option>
        </select>
      </div>
      <div class="field">
        <label for="orden_destacado">Destacar en el directorio (opcional)</label>
        <input
          type="number"
          id="orden_destacado"
          name="orden_destacado"
          min="1"
          step="1"
          style="max-width:140px"
          value={club.orden_destacado ?? ''}
        />
      </div>
    </div>

    <div class="row-actions">
      <button class="btn btn-primary" type="submit">Guardar cambios</button>
      <a class="btn btn-secondary" href="/admin/clubes">Cancelar</a>
    </div>
  </form>
</AdminLayout>
