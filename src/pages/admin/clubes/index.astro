---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAllClubes } from '../../../lib/clubes';
import EmptyState from '../../../components/EmptyState.astro';

export const prerender = false;

const db = env.DB;
const clubes = (await listAllClubes(db)).sort((a, b) => {
  const ra = a.orden_destacado ?? Infinity;
  const rb = b.orden_destacado ?? Infinity;
  if (ra !== rb) return ra - rb;
  return a.nombre.localeCompare(b.nombre, 'es');
});

const created = Astro.url.searchParams.get('created');
const updated = Astro.url.searchParams.get('updated');
const error = Astro.url.searchParams.get('error');

const MODALIDAD_LABEL: Record<string, string> = {
  presencial: 'Presencial',
  virtual: 'Virtual',
  ambas: 'Ambas',
};
---
<AdminLayout title="Clubes">
  <div class="admin-header">
    <h1>Clubes</h1>
    <a class="btn btn-primary" href="/admin/clubes/nuevo">+ Nuevo club</a>
  </div>

  {error && <div class="alert alert-error">{error}</div>}
  {created && <div class="alert alert-success">Club creado correctamente.</div>}
  {updated && <div class="alert alert-success">Club actualizado correctamente.</div>}

  {clubes.length === 0 ? (
    <EmptyState
      title="Todavía no hay clubes cargados"
      description="Los clubes que agregues acá van a aparecer en el directorio público."
      actionLabel="+ Nuevo club"
      actionHref="/admin/clubes/nuevo"
    />
  ) : (
    <table class="admin-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>País</th>
          <th>Modalidad</th>
          <th>Destacado</th>
          <th>Actividad</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {clubes.map((c) => (
          <tr>
            <td class="cell-main" data-label="Nombre">
              <a href={`/clubes/${c.slug}`} target="_blank">{c.nombre}</a>
            </td>
            <td data-label="País">{c.pais}</td>
            <td data-label="Modalidad">{MODALIDAD_LABEL[c.modalidad] ?? c.modalidad}</td>
            <td data-label="Destacado">{c.orden_destacado != null ? <span class="badge">#{c.orden_destacado}</span> : '—'}</td>
            <td data-label="Actividad">
              <span class={`badge ${c.actividad === 'inactivo' ? 'expiring' : ''}`}>{c.actividad}</span>
            </td>
            <td class="cell-actions">
              <div class="row-actions">
                <a class="btn btn-secondary" href={`/admin/clubes/editar/${c.id}`}>Editar</a>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</AdminLayout>
