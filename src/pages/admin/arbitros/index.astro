---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAllArbitros } from '../../../lib/arbitros';
import { getEmailQuotaUsage } from '../../../lib/email';
import EmptyState from '../../../components/EmptyState.astro';

export const prerender = false;

const db = env.DB;
const arbitros = (await listAllArbitros(db)).sort((a, b) => {
  const ra = a.orden_destacado ?? Infinity;
  const rb = b.orden_destacado ?? Infinity;
  if (ra !== rb) return ra - rb;
  return a.nombre_completo.localeCompare(b.nombre_completo, 'es');
});
const quota = await getEmailQuotaUsage(db);

const created = Astro.url.searchParams.get('created');
const updated = Astro.url.searchParams.get('updated');
const deleted = Astro.url.searchParams.get('deleted');
const error = Astro.url.searchParams.get('error');

const quotaPct = Math.min(100, Math.round((quota.used / quota.limit) * 100));
---
<AdminLayout title="Árbitros">
  <div class="admin-header">
    <h1>Árbitros</h1>
    <a class="btn btn-primary" href="/admin/arbitros/nuevo">+ Nuevo árbitro</a>
  </div>

  {error && <div class="alert alert-error">{error}</div>}
  {created && <div class="alert alert-success">Árbitro creado correctamente.</div>}
  {updated && <div class="alert alert-success">Árbitro actualizado correctamente.</div>}
  {deleted && <div class="alert alert-success">Árbitro eliminado.</div>}

  <div class="cleanup-box">
    <h2>Cuota de correos (Resend)</h2>
    <p>
      Enviados este mes ({quota.monthKey}): <strong>{quota.used} / {quota.limit}</strong>
      {quota.used >= quota.limit && ' — cupo agotado, el formulario público está bloqueado hasta el próximo mes.'}
    </p>
    <div class="quota-bar">
      <div class="quota-bar-fill" style={`width:${quotaPct}%`}></div>
    </div>
  </div>

  {arbitros.length === 0 ? (
    <EmptyState
      title="Todavía no hay árbitros cargados"
      description="Los perfiles que agregues acá van a aparecer en el directorio público."
      actionLabel="+ Nuevo árbitro"
      actionHref="/admin/arbitros/nuevo"
    />
  ) : (
    <table class="admin-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Estado</th>
          <th>Título</th>
          <th>Destacado</th>
          <th>Actividad</th>
          <th>Reclamado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {arbitros.map((a) => (
          <tr>
            <td>
              <a href={`/arbitros/${a.slug}`} target="_blank">{a.nombre_completo}</a>
            </td>
            <td>{a.estado_republica ?? '—'}</td>
            <td>{a.titulo ?? '—'}</td>
            <td>{a.orden_destacado != null ? <span class="badge">#{a.orden_destacado}</span> : '—'}</td>
            <td>
              <span class={`badge ${a.actividad === 'inactivo' ? 'expiring' : ''}`}>{a.actividad}</span>
            </td>
            <td>
              {a.reclamado_en ? <span class="badge">sí</span> : <span class="badge expiring">no</span>}
            </td>
            <td>
              <div class="row-actions">
                <a class="btn btn-secondary" href={`/admin/arbitros/editar/${a.id}`}>Editar</a>
                <form method="POST" action={`/api/arbitros/${a.id}/delete`} onsubmit="return confirm('¿Borrar este árbitro? Esta acción no se puede deshacer.')">
                  <button class="btn btn-danger" type="submit">Borrar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</AdminLayout>
