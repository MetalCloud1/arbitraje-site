---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getArbitroById } from '../../../../lib/arbitros';
import { ESTADOS_MX, TITULOS_ARBITRO } from '../../../../lib/postulacion';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const id = Number(Astro.params.id);
const arbitro = Number.isInteger(id) ? await getArbitroById(db, id) : null;

if (!arbitro) {
  return Astro.redirect('/admin/arbitros?error=' + encodeURIComponent('Árbitro no encontrado.'));
}

const error = Astro.url.searchParams.get('error');
const fotoUrl = arbitro.foto_key ? `/api/img/${arbitro.foto_key}` : null;
---
<AdminLayout title={`Editar — ${arbitro.nombre_completo}`}>
  <div class="admin-header">
    <h1>Editar árbitro</h1>
  </div>

  {error && <div class="alert alert-error">{error}</div>}

  <form class="form-card" method="POST" action={`/api/arbitros/${arbitro.id}`} enctype="multipart/form-data">
    <div class="field">
      <label for="nombre_completo">Nombre completo</label>
      <input type="text" id="nombre_completo" name="nombre_completo" required maxlength="100" value={arbitro.nombre_completo} />
    </div>

    <div class="field-row">
      <div class="field">
        <label for="estado_republica">Estado</label>
        <select id="estado_republica" name="estado_republica">
          <option value="">Sin especificar</option>
          {ESTADOS_MX.map((e) => <option value={e} selected={arbitro.estado_republica === e}>{e}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="titulo">Título</label>
        <select id="titulo" name="titulo">
          <option value="">Sin especificar</option>
          {TITULOS_ARBITRO.map((t) => <option value={t} selected={arbitro.titulo === t}>{t}</option>)}
        </select>
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="fide_id">ID de FIDE (opcional)</label>
        <input type="text" id="fide_id" name="fide_id" maxlength="10" value={arbitro.fide_id ?? ''} />
      </div>
      <div class="field">
        <label for="email">Correo de contacto (opcional)</label>
        <input type="email" id="email" name="email" maxlength="254" value={arbitro.email ?? ''} />
        <p class="field-hint">Solo se muestra públicamente si el perfil está marcado como reclamado.</p>
      </div>
    </div>

    <div class="field">
      <label for="bio">Descripción / trayectoria</label>
      <textarea id="bio" name="bio" rows="5" maxlength="1000">{arbitro.bio ?? ''}</textarea>
    </div>

    <div class="field">
      <label for="foto">Foto</label>
      {fotoUrl && <img class="cover-preview" src={fotoUrl} alt={arbitro.nombre_completo} />}
      <input type="file" id="foto" name="foto" accept="image/png,image/jpeg,image/webp,image/gif" style="margin-top:10px;" />
      <p class="field-hint">Sube una nueva foto para reemplazar la actual.</p>
      {fotoUrl && (
        <label style="display:flex; align-items:center; gap:8px; margin-top:10px; font-weight:400;">
          <input type="checkbox" name="remove_foto" style="width:auto;" />
          Quitar la foto actual
        </label>
      )}
    </div>

    <div class="field-row">
      <div class="field">
        <label for="actividad">Actividad</label>
        <select id="actividad" name="actividad">
          <option value="activo" selected={arbitro.actividad === 'activo'}>Activo</option>
          <option value="inactivo" selected={arbitro.actividad === 'inactivo'}>Inactivo</option>
        </select>
      </div>
      <div class="field field-checkbox">
        <label>
          <input type="checkbox" name="reclamado" checked={!!arbitro.reclamado_en} />
          Identidad ya verificada (reclamado)
        </label>
        {arbitro.reclamado_en && <p class="field-hint">Reclamado el {new Date(arbitro.reclamado_en).toLocaleDateString('es-MX')}</p>}
      </div>
    </div>

    <div class="field">
      <label for="orden_destacado">Destacar en el directorio (opcional)</label>
      <input
        type="number"
        id="orden_destacado"
        name="orden_destacado"
        min="1"
        step="1"
        style="max-width:140px"
        value={arbitro.orden_destacado ?? ''}
      />
      <p class="field-hint">
        Vacío = orden alfabético normal, como el resto. Si le pones un número, aparece antes que los
        alfabéticos (1 primero, 2 después, etc.), sin importar el nombre. Es una excepción editorial puntual,
        no un ranking.
      </p>
    </div>

    <div class="row-actions">
      <button class="btn btn-primary" type="submit">Guardar cambios</button>
      <a class="btn btn-secondary" href="/admin/arbitros">Cancelar</a>
    </div>
  </form>
</AdminLayout>
