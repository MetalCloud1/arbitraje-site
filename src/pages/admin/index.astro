---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAllArticles } from '../../lib/db';
import { formatDateEs } from '../../lib/text';
import EmptyState from '../../components/EmptyState.astro';

export const prerender = false;

const db = env.DB;
const articles = await listAllArticles(db);

const created = Astro.url.searchParams.get('created');
const updated = Astro.url.searchParams.get('updated');
const error = Astro.url.searchParams.get('error');

function daysLeft(expiresAt: string): number {
  return Math.ceil((new Date(expiresAt).getTime() - Date.now()) / (24 * 60 * 60 * 1000));
}
---
<AdminLayout title="Artículos">
  <div class="admin-header">
    <h1>Artículos</h1>
    <a class="btn btn-primary" href="/admin/nuevo">+ Nuevo artículo</a>
  </div>

  {error && <div class="alert alert-error">{error}</div>}
  {created && <div class="alert alert-success">Artículo publicado correctamente.</div>}
  {updated && <div class="alert alert-success">Artículo actualizado correctamente.</div>}

  {articles.length === 0 ? (
    <EmptyState
      title="Todavía no has publicado ningún artículo"
      description="Los artículos que publiques van a aparecer acá, con su estado y fecha de eliminación."
      actionLabel="+ Nuevo artículo"
      actionHref="/admin/nuevo"
    />
  ) : (
    <table class="admin-table">
      <thead>
        <tr>
          <th>Título</th>
          <th>Categoría</th>
          <th>Publicado</th>
          <th>Eliminación</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {articles.map((a) => (
          <tr>
            <td class="cell-main" data-label="Título">
              <a href={`/articulos/${a.slug}`} target="_blank">{a.title}</a>
            </td>
            <td data-label="Categoría">{a.category}</td>
            <td data-label="Publicado">{formatDateEs(a.published_at)}</td>
            <td data-label="Eliminación">
              {a.expires_at ? (
                <span class="badge expiring">en {daysLeft(a.expires_at)} día(s)</span>
              ) : (
                <span class="badge">indefinido</span>
              )}
            </td>
            <td class="cell-actions">
              <div class="row-actions">
                <a class="btn btn-secondary" href={`/admin/editar/${a.id}`}>Editar</a>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</AdminLayout>