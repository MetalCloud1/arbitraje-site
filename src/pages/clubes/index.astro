---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listClubesPage, countClubes, listPaisesConClubes } from '../../lib/clubes';
import EmptyState from '../../components/EmptyState.astro';

export const prerender = false;

// Cuadrícula, no lista: acá alcanza con más tarjetas por página que en
// entrenadores/árbitros (que son filas verticales angostas).
const PAGE_SIZE = 12;

const db = env.DB;
const paisFiltro = Astro.url.searchParams.get('pais');

const [{ items: clubes, nextCursor }, total, paises] = await Promise.all([
  listClubesPage(db, { pais: paisFiltro, limit: PAGE_SIZE }),
  countClubes(db),
  listPaisesConClubes(db),
]);

const descripcion = `Clubes de ajedrez con dirección, contacto y horarios de clase. ${total} clubes registrados.`;
---
<BaseLayout title="Clubes - La Hora del Arbitraje" description="Directorio de clubes de ajedrez: dirección, contacto, días de clase y modalidad de cada uno.">
  <div class="container clubes-page">
    <div class="clubes-header">
      <div class="clubes-header-copy">
        <h1>Clubes</h1>
        <p class="clubes-intro">{descripcion}</p>
      </div>
      <a class="btn btn-primary clubes-cta" href="/clubes/postular">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Registrar mi club
      </a>
    </div>

    <div class="clubes-controls">
      <div class="clubes-search-wrap">
        <svg class="clubes-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" />
        </svg>
        <input
          type="search"
          class="clubes-search-input"
          data-clubes-search-input
          placeholder="Buscar club por nombre, país o dirección…"
          aria-label="Buscar club"
          autocomplete="off"
        />
      </div>
    </div>

    {paises.length > 0 && (
      <div class="clubes-filtros-wrap">
        <div class="clubes-filtros">
          <a class={`filtro-chip ${!paisFiltro ? 'active' : ''}`} href="/clubes">Todos</a>
          {paises.map((p) => (
            <a class={`filtro-chip ${paisFiltro === p ? 'active' : ''}`} href={`/clubes?pais=${encodeURIComponent(p)}`}>{p}</a>
          ))}
        </div>
      </div>
    )}

    <div
      class="clubes-root"
      data-clubes-root
      data-pais={paisFiltro ?? ''}
      data-cursor={nextCursor ?? ''}
    >
      {clubes.length === 0 ? (
        <EmptyState
          title={paisFiltro ? 'Ningún club registrado con ese filtro todavía' : 'Todavía no hay clubes registrados'}
          description="¿Tienes un club y quieres aparecer acá?"
          actionLabel="Registrar mi club"
          actionHref="/clubes/postular"
        />
      ) : (
        <div class="clubes-grid reveal-stagger" data-clubes-grid>
          {clubes.map((c) => (
            <a class="club-card" href={`/clubes/${encodeURIComponent(c.slug)}`}>
              <div class="club-card-logo">
                {c.logo_key ? (
                  <img src={`/api/img/${c.logo_key}`} alt={c.nombre} loading="lazy" />
                ) : (
                  <span class="club-card-logo-fallback" aria-hidden="true">{c.nombre.charAt(0).toUpperCase()}</span>
                )}
              </div>
              <span class="club-card-nombre">{c.nombre}</span>
            </a>
          ))}
        </div>
      )}
      <div class="clubes-sentinel" data-clubes-sentinel>
        <div class="clubes-loading" data-clubes-loading hidden>
          <span class="clubes-loading-dot"></span>
          <span class="clubes-loading-dot"></span>
          <span class="clubes-loading-dot"></span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function escapeHtml(value: string): string {
    return value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  }

  interface ClubResumen {
    id: number;
    slug: string;
    nombre: string;
    pais: string;
    logo_key: string | null;
  }

  function cardHtml(c: ClubResumen): string {
    // Sin encodeURIComponent sobre logo_key (ver nota gemela en
    // entrenadores/index.astro): codificaría la "/" y la ruta catch-all
    // /api/img/[...key] no matchearía.
    const logoUrl = c.logo_key ? `/api/img/${c.logo_key}` : null;
    return `
      <a class="club-card" href="/clubes/${encodeURIComponent(c.slug)}">
        <div class="club-card-logo">
          ${logoUrl
            ? `<img src="${logoUrl}" alt="${escapeHtml(c.nombre)}" loading="lazy" />`
            : `<span class="club-card-logo-fallback" aria-hidden="true">${escapeHtml(c.nombre.charAt(0).toUpperCase())}</span>`}
        </div>
        <span class="club-card-nombre">${escapeHtml(c.nombre)}</span>
      </a>`;
  }

  const PAGE_SIZE = 12;
  const MIN_QUERY_LENGTH = 2;
  const DEBOUNCE_MS = 300;

  function initClubesPage(root: Element) {
    if (root.getAttribute('data-clubes-bound') === 'true') return;
    root.setAttribute('data-clubes-bound', 'true');

    const searchInput = document.querySelector('[data-clubes-search-input]');
    const sentinel = root.querySelector('[data-clubes-sentinel]');
    const loadingEl = root.querySelector('[data-clubes-loading]');
    if (!(sentinel instanceof HTMLElement) || !(loadingEl instanceof HTMLElement)) return;

    const pais = root.getAttribute('data-pais') || '';
    let cursor = root.getAttribute('data-cursor') || '';
    let query = '';
    let loading = false;
    let requestId = 0;

    const ensureGrid = (): HTMLElement => {
      const existing = root.querySelector('[data-clubes-grid]');
      if (existing instanceof HTMLElement) return existing;
      const el = document.createElement('div');
      el.className = 'clubes-grid reveal-stagger is-visible';
      el.setAttribute('data-clubes-grid', '');
      root.insertBefore(el, sentinel);
      return el;
    };

    const showEmpty = () => {
      const existing = root.querySelector('[data-clubes-grid]');
      existing?.remove();
      let empty = root.querySelector('[data-clubes-empty]');
      if (!empty) {
        empty = document.createElement('div');
        empty.setAttribute('data-clubes-empty', '');
        empty.className = 'empty-state';
        root.insertBefore(empty, sentinel);
      }
      empty.innerHTML = `
        <p class="empty-state-title">Sin resultados${query ? ` para “${escapeHtml(query)}”` : ''}</p>
        <p class="empty-state-description">Probá con otro nombre, país o dirección.</p>`;
    };

    const clearEmpty = () => root.querySelector('[data-clubes-empty]')?.remove();

    const fetchPage = async (reset: boolean) => {
      if (loading) return;
      if (!reset && !cursor) return;
      loading = true;
      loadingEl.hidden = false;
      const myRequestId = ++requestId;

      const params = new URLSearchParams({ limit: String(PAGE_SIZE) });
      if (pais) params.set('pais', pais);
      if (query.length >= MIN_QUERY_LENGTH) params.set('q', query);
      if (!reset && cursor) params.set('cursor', cursor);

      try {
        const res = await fetch(`/api/clubes/directorio?${params.toString()}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: { items: ClubResumen[]; nextCursor: string | null } = await res.json();
        if (myRequestId !== requestId) return;

        cursor = data.nextCursor || '';

        if (reset && data.items.length === 0) {
          showEmpty();
        } else {
          clearEmpty();
          const gridEl = ensureGrid();
          if (reset) gridEl.innerHTML = '';
          gridEl.insertAdjacentHTML('beforeend', data.items.map(cardHtml).join(''));
        }

        // Ver la nota gemela en entrenadores/index.astro: forzamos una
        // re-evaluación después de insertar por si el sentinel no salió
        // de la zona observada con esta sola página.
        if (cursor) {
          requestAnimationFrame(() => {
            if (loading || !cursor) return;
            const rect = sentinel.getBoundingClientRect();
            if (rect.top <= window.innerHeight + 400) fetchPage(false);
          });
        }
      } catch {
        if (myRequestId !== requestId) return;
        loadingEl.hidden = true;
      } finally {
        if (myRequestId === requestId) {
          loading = false;
          loadingEl.hidden = true;
        }
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !loading && cursor) fetchPage(false);
        }
      },
      { rootMargin: '400px 0px' }
    );
    io.observe(sentinel);

    if (searchInput instanceof HTMLInputElement) {
      let debounceTimer: ReturnType<typeof setTimeout> | null = null;
      searchInput.addEventListener('input', () => {
        const value = searchInput.value.trim();
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          if (value.length > 0 && value.length < MIN_QUERY_LENGTH) return;
          query = value;
          fetchPage(true);
        }, DEBOUNCE_MS);
      });
    }
  }

  function initAllClubesPages() {
    document.querySelectorAll('[data-clubes-root]').forEach(initClubesPage);
  }

  document.addEventListener('astro:page-load', initAllClubesPages);
</script>

<script>
  function initClubesReveal() {
    const grid = document.querySelector('.clubes-grid.reveal-stagger:not(.is-visible)');
    if (!grid || grid.getAttribute('data-reveal-bound') === 'true') return;
    grid.setAttribute('data-reveal-bound', 'true');

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08 }
    );
    io.observe(grid);
  }

  document.addEventListener('astro:page-load', initClubesReveal);
</script>
