---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAISES_CLUBES } from '../../lib/paises';
import { DIAS_SEMANA, MODALIDADES } from '../../lib/clubes';

export const prerender = false;

const TURNSTILE_SITE_KEY = env.PUBLIC_TURNSTILE_SITE_KEY;

const enviado = Astro.url.searchParams.get('enviado') === '1';
const error = Astro.url.searchParams.get('error');
---
<BaseLayout title="Registrar mi club - La Hora del Arbitraje" noindex>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="container postular-page">
    <a class="back-link" href="/clubes">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Volver a clubes
    </a>

    <h1>Registrar mi club</h1>

    <p class="postular-intro">
      Este formulario no publica tu club automáticamente: la información llega a un humano que la revisa
      antes de sumarlo al directorio.
    </p>

    {enviado && (
      <div class="alert alert-success">
        Tu postulación fue enviada. Te contactaremos por correo si hace falta algo más.
      </div>
    )}
    {error && <div class="alert alert-error">{error}</div>}

    {!enviado && (
      <form class="form-card" method="POST" action="/api/clubes/postular">
        {/* Honeypot: invisible para una persona, tentador para un bot. */}
        <div class="hp-field" aria-hidden="true">
          <label for="sitio_contacto">Sitio de contacto</label>
          <input type="text" id="sitio_contacto" name="sitio_contacto" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field">
          <label for="nombre">Nombre del club</label>
          <input type="text" id="nombre" name="nombre" required minlength="3" maxlength="120" />
        </div>

        <div class="field-row">
          <div class="field">
            <label for="pais">País</label>
            <select id="pais" name="pais" required>
              <option value="" disabled selected>Selecciona un país</option>
              {PAISES_CLUBES.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="modalidad">Modalidad</label>
            <select id="modalidad" name="modalidad" required data-modalidad-select>
              <option value="" disabled selected>Selecciona una modalidad</option>
              {MODALIDADES.map((m) => <option value={m.value}>{m.label}</option>)}
            </select>
          </div>
        </div>

        <div class="field" data-direccion-field>
          <label for="direccion">Dirección (estado/provincia, ciudad, calle)</label>
          <input type="text" id="direccion" name="direccion" maxlength="300" placeholder="Ej. Jalisco, Guadalajara, Av. Chapultepec 123" />
          <p class="field-hint">Obligatoria si el club es presencial o mixto. No hace falta si es solo virtual.</p>
        </div>

        <div class="field">
          <label>Días que imparten clases</label>
          <div class="dias-checkboxes">
            {DIAS_SEMANA.map((d) => (
              <label class="dia-checkbox">
                <input type="checkbox" name="dias" value={d} />
                {d}
              </label>
            ))}
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="telefono">Teléfono (opcional si dejas WhatsApp)</label>
            <input type="tel" id="telefono" name="telefono" maxlength="20" />
          </div>
          <div class="field">
            <label for="whatsapp">WhatsApp (opcional si dejas teléfono)</label>
            <input type="tel" id="whatsapp" name="whatsapp" maxlength="20" />
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" required maxlength="254" />
          </div>
          <div class="field">
            <label for="sitio_web">Sitio web o red social (opcional)</label>
            <input type="url" id="sitio_web" name="sitio_web" maxlength="300" placeholder="https://..." />
          </div>
        </div>

        <div class="field">
          <label for="bio">Breve descripción del club</label>
          <textarea
            id="bio"
            name="bio"
            required
            minlength="20"
            maxlength="1000"
            rows="5"
            data-char-counter
          ></textarea>
          <p class="field-hint"><span data-char-count>0</span>/1000 caracteres</p>
        </div>

        <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-action="postular-club" data-theme="dark"></div>

        <p class="postular-ip-notice">
          Tu IP se subirá de forma automática junto con tu formulario, como parte de la revisión antispam.
        </p>

        <div class="row-actions">
          <button class="btn btn-primary" type="submit">Enviar postulación</button>
        </div>
      </form>
    )}
  </div>

  <script>
    // Contador de caracteres de la bio -- puramente cosmético, la
    // validación real siempre corre en el servidor.
    document.querySelectorAll('[data-char-counter]').forEach((el) => {
      if (!(el instanceof HTMLTextAreaElement)) return;
      const counter = el.parentElement?.querySelector('[data-char-count]');
      const update = () => {
        if (counter) counter.textContent = String(el.value.length);
      };
      el.addEventListener('input', update);
      update();
    });

    // La dirección es obligatoria salvo que la modalidad sea "solo virtual".
    // Puramente cosmético (required dinámico) -- el servidor valida igual.
    document.querySelectorAll('[data-modalidad-select]').forEach((el) => {
      if (!(el instanceof HTMLSelectElement)) return;
      const direccionInput = document.getElementById('direccion');
      const direccionField = document.querySelector('[data-direccion-field]');
      const update = () => {
        const esVirtual = el.value === 'virtual';
        if (direccionInput instanceof HTMLInputElement) direccionInput.required = !esVirtual;
        direccionField?.classList.toggle('is-optional', esVirtual);
      };
      el.addEventListener('change', update);
      update();
    });

    document.addEventListener('submit', (event) => {
      if (event.defaultPrevented) return;
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;
      const submitBtn = form.querySelector('button[type="submit"]');
      if (!(submitBtn instanceof HTMLButtonElement) || submitBtn.disabled) return;
      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');
      submitBtn.setAttribute('aria-busy', 'true');
    });
  </script>
</BaseLayout>
