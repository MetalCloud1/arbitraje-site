---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticleBySlug } from '../../lib/db';
import { formatDateEs, splitAfterFirstParagraph, wrapTables } from '../../lib/text';
import { parseVideoUrlSafe } from '../../lib/video';
import MediaFrame from '../../components/MediaFrame.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';

export const prerender = false;

const db = env.DB;
const { slug } = Astro.params;
const article = slug ? await getArticleBySlug(db, slug) : null;

if (!article) {
  return Astro.rewrite('/404');
}

const video = parseVideoUrlSafe(article.video_url);
const coverUrl = !video && article.cover_key ? `/api/img/${article.cover_key}` : null;

// Imagen de fondo del encabezado (desenfocada y oscurecida por CSS). Sale de
// la portada subida si existe (mejor calidad, también en artículos con
// video) o, si no, de la miniatura de YouTube. Un video de Facebook sin
// portada no tiene imagen posible: el encabezado queda liso.
const heroUrl = article.cover_key ? `/api/img/${article.cover_key}` : (video?.thumbnailUrl ?? null);

// La imagen nítida o el video van después del primer párrafo: el lector
// arranca directo en el texto y la media aparece cuando ya está leyendo,
// no al final donde casi nadie llega. Sin media no hay nada que insertar.
const hasInlineMedia = Boolean(video || coverUrl);
const { head, tail } = hasInlineMedia
  ? splitAfterFirstParagraph(article.content_html)
  : { head: article.content_html, tail: '' };

const publishedIso = new Date(article.published_at).toISOString();
const modifiedIso = new Date(article.updated_at ?? article.published_at).toISOString();
const canonicalArticleUrl = new URL(`/articulos/${article.slug}`, Astro.url.origin).toString();

// NewsArticle en vez de Article genérico: es el tipo correcto de schema.org
// para contenido periodístico/editorial como el de este sitio.
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: article.title,
  description: article.excerpt ?? undefined,
  image: coverUrl ? [new URL(coverUrl, Astro.url.origin).toString()] : undefined,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  articleSection: article.category,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalArticleUrl },
  author: { '@type': 'Organization', name: 'La Hora del Arbitraje' },
  publisher: {
    '@type': 'Organization',
    name: 'La Hora del Arbitraje',
    logo: { '@type': 'ImageObject', url: new URL('/logo.svg', Astro.url.origin).toString() },
  },
};
---
<BaseLayout
  title={`${article.title} - La Hora del Arbitraje`}
  description={article.excerpt ?? undefined}
  image={coverUrl ?? undefined}
  type="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  jsonLd={articleJsonLd}
>
  <ReadingProgress targetSelector=".article-content" />
  <article class="article-page">
    <header class={`article-hero${heroUrl ? ' has-image' : ''}`}>
      {heroUrl && (
        <div class="article-hero-media" aria-hidden="true" transition:name={`article-cover-${article.slug}`}>
          <img
            class="article-hero-img"
            src={heroUrl}
            alt=""
            loading="eager"
            fetchpriority="high"
            onerror="this.parentElement.style.display='none'"
          />
        </div>
      )}
      <div class="container">
        <div class="article-hero-inner">
          <a class="back-link" href="/articulos">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Volver a artículos
          </a>

          <div class="article-category">{article.category}</div>
          <h1 transition:name={`article-title-${article.slug}`}>{article.title}</h1>

          <div class="article-meta">
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              {formatDateEs(article.published_at)}
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              {article.read_minutes} min de lectura
            </span>
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="article-detail article-detail-body">
        {/* .article-content agrupa texto + media para que la barra de progreso
            de lectura mida el artículo completo, no solo el primer tramo. */}
        <div class="article-content">
          {head && <div class="article-body" set:html={wrapTables(head)} />}

          {video && (
            <div class="article-video-embed">
              <iframe
                src={video.embedUrl}
                title={article.title}
                loading="lazy"
                allow="autoplay; encrypted-media; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          )}
          {coverUrl && (
            <div class="article-cover-frame">
              {/* El view-transition de la portada vive en el fondo del
                  encabezado (arriba, siempre visible), no acá. */}
              <MediaFrame imageUrl={coverUrl} alt={article.title} />
            </div>
          )}

          {tail && <div class={head ? 'article-body article-body-cont' : 'article-body'} set:html={wrapTables(tail)} />}
        </div>

        {/* Fuera de .article-content a propósito: no debe contar para la
            barra de progreso de lectura, que ya llegó al 100% cuando el
            lector ve esto. */}
        <div class="article-footer">
          <a class="btn btn-primary article-footer-btn" href="/articulos">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Ver más artículos
          </a>

          <div class="share-menu" data-share-root>
            <button
              type="button"
              class="btn btn-secondary share-trigger"
              data-share-trigger
              data-share-title={article.title}
              data-share-url={canonicalArticleUrl}
              aria-expanded="false"
              aria-controls="share-panel"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 10.5l6.8-4M8.6 13.5l6.8 4"/></svg>
              Compartir
            </button>

            <div class="share-panel" id="share-panel" data-share-panel hidden>
              <a class="share-option" data-share-x href="#" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.6 8.7L23.3 22h-7.1l-5.6-6.9L4.2 22H1l8.1-9.3L1 2h7.3l5 6.3L18.9 2Zm-1.2 18h1.9L6.4 4H4.4l13.3 16Z"/></svg>
                <span>X (Twitter)</span>
              </a>
              <a class="share-option" data-share-facebook href="#" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5H16l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46H16.5V4.36C16.24 4.32 15.36 4.25 14.34 4.25c-2.13 0-3.59 1.3-3.59 3.68v2.06H8.3v3H10.75V21h2.75Z"/></svg>
                <span>Facebook</span>
              </a>
              <a class="share-option" data-share-whatsapp href="#" target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.94-.27-.1-.46-.15-.66.15-.2.3-.75.94-.92 1.13-.17.2-.34.22-.63.08-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.03-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.5.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.66-1.6-.9-2.2-.24-.57-.48-.5-.66-.5h-.56c-.2 0-.5.07-.77.37-.27.3-1 .98-1 2.4s1.03 2.78 1.17 2.97c.15.2 2.03 3.1 4.93 4.35.69.3 1.22.47 1.64.6.69.22 1.32.19 1.82.11.55-.08 1.7-.7 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.13-.26-.2-.56-.35Z"/><path d="M12 2a10 10 0 0 0-8.6 15.06L2 22l5.1-1.34A10 10 0 1 0 12 2Zm0 18.2c-1.62 0-3.2-.44-4.57-1.26l-.33-.2-3.03.8.81-2.95-.21-.34A8.2 8.2 0 1 1 12 20.2Z"/></svg>
                <span>WhatsApp</span>
              </a>
              <button type="button" class="share-option" data-share-copy>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span data-copy-label>Copiar enlace</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  <script>
    // Widgets del artículo (tablero, problema, trivia, incrustación): el código
    // solo se descarga si el artículo tiene alguno, y cada widget se inicia
    // cuando se acerca a la pantalla. Ver src/lib/widgets.
    const boot = () => {
      if (document.querySelector('.article-body [data-widget]')) {
        import('../../lib/widgets/client/mount').then((m) => m.hydrateWidgets());
      }
    };
    boot();
    document.addEventListener('astro:page-load', boot);
  </script>

  <script>
    // Botón "Compartir" del pie de artículo. En móvil, donde casi siempre
    // hay navigator.share, abre el share sheet nativo del sistema (así
    // llega a cualquier app instalada, no solo a las 3 que listamos acá).
    // Cuando no existe (la mayoría de escritorio), cae a un menú propio con
    // los enlaces de siempre + copiar al portapapeles.
    function initShareMenu(root: Element) {
      const trigger = root.querySelector('[data-share-trigger]');
      const panel = root.querySelector('[data-share-panel]');
      const copyBtn = root.querySelector('[data-share-copy]');
      const copyLabel = root.querySelector('[data-copy-label]');

      if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

      const url = trigger.dataset.shareUrl || window.location.href;
      const title = trigger.dataset.shareTitle || document.title;

      const xLink = root.querySelector('[data-share-x]');
      const fbLink = root.querySelector('[data-share-facebook]');
      const waLink = root.querySelector('[data-share-whatsapp]');
      if (xLink instanceof HTMLAnchorElement) {
        xLink.href = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
      }
      if (fbLink instanceof HTMLAnchorElement) {
        fbLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
      }
      if (waLink instanceof HTMLAnchorElement) {
        waLink.href = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
      }

      const openPanel = () => {
        panel.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        root.classList.add('is-open');
      };

      const closePanel = () => {
        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        root.classList.remove('is-open');
      };

      const onTriggerClick = async () => {
        if (typeof navigator.share === 'function') {
          try {
            await navigator.share({ title, url });
            return;
          } catch (err) {
            // AbortError = el usuario cerró el share sheet nativo sin elegir
            // nada; no es un error real, simplemente no hacemos más nada.
            if (err instanceof Error && err.name === 'AbortError') return;
          }
        }
        root.classList.contains('is-open') ? closePanel() : openPanel();
      };

      const onCopyClick = async () => {
        try {
          await navigator.clipboard.writeText(url);
          if (copyLabel instanceof HTMLElement) {
            const original = copyLabel.textContent;
            copyLabel.textContent = '¡Enlace copiado!';
            setTimeout(() => {
              copyLabel.textContent = original;
            }, 1800);
          }
        } catch {
          // Sin permiso de portapapeles (poco común): no rompemos nada, el
          // enlace ya está en la barra del navegador.
        }
        closePanel();
      };

      const onDocumentClick = (e: MouseEvent) => {
        if (!root.contains(e.target as Node)) closePanel();
      };

      const onDocumentKeydown = (e: KeyboardEvent) => {
        if (e.key === 'Escape' && root.classList.contains('is-open')) {
          closePanel();
          trigger.focus();
        }
      };

      trigger.addEventListener('click', onTriggerClick);
      copyBtn?.addEventListener('click', onCopyClick);
      document.addEventListener('click', onDocumentClick);
      document.addEventListener('keydown', onDocumentKeydown);

      document.addEventListener(
        'astro:before-swap',
        () => {
          document.removeEventListener('click', onDocumentClick);
          document.removeEventListener('keydown', onDocumentKeydown);
        },
        { once: true }
      );
    }

    function initAllShareMenus() {
      document.querySelectorAll('[data-share-root]').forEach(initShareMenu);
    }

    document.addEventListener('astro:page-load', initAllShareMenus);
  </script>
</BaseLayout>