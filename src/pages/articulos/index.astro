---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import KnightMark from '../../components/KnightMark.astro';
import EmptyState from '../../components/EmptyState.astro';
import { listAllArticles, searchArticles } from '../../lib/db';

export const prerender = false;

const db = env.DB;
const categoria = Astro.url.searchParams.get('categoria');
const buscar = Astro.url.searchParams.get('buscar')?.trim() || null;

const articles = buscar
  ? await searchArticles(db, buscar)
  : await (async () => {
      const all = await listAllArticles(db);
      return categoria ? all.filter((a) => a.category === categoria) : all;
    })();

const heading = buscar ? `Resultados para "${buscar}"` : categoria ? categoria : 'Todos los Artículos';

// Los resultados de búsqueda son contenido efímero y específico de cada
// consulta: no aportan nada nuevo que indexar y compiten por posicionamiento
// con la propia página de artículos. El filtro por categoría vía query param
// tiene el mismo problema (contenido duplicado de /articulos con otro título),
// así que ambos se marcan noindex hasta que existan rutas propias por
// categoría (p. ej. /articulos/categoria/casos) que sí valga la pena indexar.
const shouldNoindex = Boolean(buscar || categoria);

const CATEGORIAS = ['Casos', 'Entrevistas', 'Análisis', 'Podcast'];
---
<BaseLayout
  title={`${buscar ? `Buscar: ${buscar}` : 'Artículos'} - La Hora del Arbitraje`}
  noindex={shouldNoindex}
>
  <section class="articles-section">
    <div class="container">
      <div class="section-header">
        <div class="section-title">
          <KnightMark class="section-mark" />
          <h1>{heading}</h1>
        </div>

        <div class="articulos-filter-wrap" data-articulos-filter-root>
          <button
            type="button"
            class="arbitros-icon-btn"
            data-articulos-filter-toggle
            aria-expanded="false"
            aria-controls="articulos-filter-panel"
            aria-label="Filtrar por categoría"
            title="Filtrar por categoría"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="4" y1="6" x2="20" y2="6" /><circle cx="9" cy="6" r="2" fill="currentColor" stroke="none" />
              <line x1="4" y1="12" x2="20" y2="12" /><circle cx="15" cy="12" r="2" fill="currentColor" stroke="none" />
              <line x1="4" y1="18" x2="20" y2="18" /><circle cx="7" cy="18" r="2" fill="currentColor" stroke="none" />
            </svg>
          </button>

          <nav
            class="articulos-filter-panel"
            data-articulos-filter-panel
            id="articulos-filter-panel"
            aria-label="Filtrar por categoría"
            hidden
          >
            <div class="arbitros-filtros">
              <a
                href="/articulos"
                class={!categoria && !buscar ? 'filtro-chip active' : 'filtro-chip'}
                aria-current={!categoria && !buscar ? 'page' : undefined}
              >Todos</a>
              {CATEGORIAS.map((c) => (
                <a
                  href={`/articulos?categoria=${encodeURIComponent(c)}`}
                  class={categoria === c && !buscar ? 'filtro-chip active' : 'filtro-chip'}
                  aria-current={categoria === c && !buscar ? 'page' : undefined}
                >{c}</a>
              ))}
            </div>
          </nav>
        </div>
      </div>

      {articles.length === 0 && (
        buscar ? (
          <EmptyState
            title={`Sin resultados para "${buscar}"`}
            description="Probá con otra palabra o revisá la ortografía."
            actionLabel="Ver todos los artículos"
            actionHref="/articulos"
          />
        ) : categoria ? (
          <EmptyState
            title={`Sin resultados en "${categoria}"`}
            description="No hay artículos publicados en esta categoría todavía."
            actionLabel="Ver todos los artículos"
            actionHref="/articulos"
          />
        ) : (
          <EmptyState
            title="Todavía no hay artículos publicados"
            description="Vuelve pronto para ver las últimas noticias y análisis de arbitraje."
          />
        )
      )}

      {articles.length > 0 && (
        <div class="articles-grid reveal" data-reveal-target>
          {articles.map((article) => <ArticleCard article={article} enableTransitions={false} />)}
        </div>
      )}
    </div>
  </section>

  <script>
    // Reveal del grid: acá usamos .reveal (fade simple de todo el bloque),
    // no .reveal-stagger como en el home/arbitros/entrenadores/clubes. El
    // escalonado por tarjeta de .reveal-stagger tiene un tope de 8 items
    // (nth-child(n+8) comparten el mismo delay) -- funciona en listas
    // paginadas de a 10, pero acá se listan TODOS los artículos sin límite
    // (ver listAllArticles arriba), así que con más de 8 el resto aparecía
    // todo junto de golpe. Un fade único evita ese "estallido".
    //
    // threshold: 0 (no 0.08 como en las otras páginas) por el mismo motivo
    // de fondo: el grid puede ser mucho más alto que la pantalla, y un
    // umbral en porcentaje del alto total casi nunca se cumple sin
    // scrollear bastante -- quedaba todo invisible hasta moverse.
    function initArticulosReveal() {
      const grid = document.querySelector('.articles-grid.reveal[data-reveal-target]:not(.is-visible)');
      if (!grid || grid.getAttribute('data-reveal-bound') === 'true') return;
      grid.setAttribute('data-reveal-bound', 'true');

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0 }
      );
      io.observe(grid);
    }

    document.addEventListener('astro:page-load', initArticulosReveal);
  </script>

  <script>
    // Botón de filtro por categoría: mismo patrón que el ícono de embudo de
    // /arbitros/directorio, /entrenadores y /clubes (panel desplegable que se
    // abre y cierra, se cierra con click afuera o Escape). Acá el panel es un
    // dropdown anclado al botón (no un bloque fijo en el flujo) para que las
    // cápsulas no dependan del ancho de pantalla ni exijan scroll horizontal:
    // adentro del panel simplemente envuelven en varias líneas si hace falta.
    function initArticulosFilter(root: Element) {
      if (root.getAttribute('data-articulos-filter-bound') === 'true') return;
      root.setAttribute('data-articulos-filter-bound', 'true');

      const toggle = root.querySelector('[data-articulos-filter-toggle]');
      const panel = root.querySelector('[data-articulos-filter-panel]');
      if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

      const close = () => {
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.classList.remove('is-active');
      };

      const open = () => {
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        toggle.classList.add('is-active');
      };

      toggle.addEventListener('click', () => (panel.hidden ? open() : close()));

      const onDocumentClick = (event: MouseEvent) => {
        if (!root.contains(event.target as Node)) close();
      };
      const onDocumentKeydown = (event: KeyboardEvent) => {
        if (event.key === 'Escape' && !panel.hidden) {
          close();
          toggle.focus();
        }
      };

      document.addEventListener('click', onDocumentClick);
      document.addEventListener('keydown', onDocumentKeydown);

      // Sin esto, cada ida y vuelta a /articulos en la misma sesión (sin
      // recarga completa, vía ClientRouter) deja un par de listeners más
      // colgados de document -- nunca se quitan solos porque el elemento
      // "root" al que apuntan ya no existe, pero el listener sigue vivo y
      // sigue corriendo en cada click/tecla de TODO el sitio. Con suficiente
      // navegación, eso sí se nota como lentitud real, no del dispositivo.
      document.addEventListener(
        'astro:before-swap',
        () => {
          document.removeEventListener('click', onDocumentClick);
          document.removeEventListener('keydown', onDocumentKeydown);
        },
        { once: true }
      );
    }

    function initAllArticulosFilters() {
      document.querySelectorAll('[data-articulos-filter-root]').forEach(initArticulosFilter);
    }

    document.addEventListener('astro:page-load', initAllArticulosFilters);
  </script>
</BaseLayout>