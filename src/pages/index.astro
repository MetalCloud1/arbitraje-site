---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FeaturedArticles from '../components/FeaturedArticles.astro';
import KnightMark from '../components/KnightMark.astro';
import { listRecentArticles } from '../lib/db';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const articles = await listRecentArticles(db, 8);

const featured = articles[0] ?? null;
const secondary = articles.slice(1, 4);
const recentGrid = articles.slice(4, 8);
---
<BaseLayout title="La Hora del Arbitraje — Chess.com">
  <Hero />

  {featured && (
    <section class="featured-section">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-title">
            <KnightMark class="section-mark" />
            <span>Destacado</span>
          </div>
        </div>
        <FeaturedArticles featured={featured} secondary={secondary} />
      </div>
    </section>
  )}

  {(recentGrid.length > 0 || articles.length === 0) && (
    <section class="articles-section">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-title">
            <KnightMark class="section-mark" />
            <span>Artículos Recientes</span>
          </div>
          <a class="view-all" href="/articulos">
            Ver todos los artículos
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>

        {articles.length === 0 && (
          <p class="empty-state">Todavía no hay artículos publicados. Vuelve pronto.</p>
        )}

        {recentGrid.length > 0 && (
          <div class="articles-grid reveal-stagger">
            {recentGrid.map((article) => <ArticleCard article={article} />)}
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>