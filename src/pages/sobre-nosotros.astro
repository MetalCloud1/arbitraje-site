---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sobre Nosotros - La Hora del Arbitraje">
  <div class="container">
    <article class="article-detail">
      <h1>Sobre Nosotros</h1>
      <div class="article-body">
        <p>
          La Hora del Arbitraje es un espacio en alianza con Chess.com dedicado a las noticias,
          el análisis y las entrevistas sobre el arbitraje y la integridad en el ajedrez competitivo.
        </p>
      </div>
    </article>
  </div>
</BaseLayout>
