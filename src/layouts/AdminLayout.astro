---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Admin</title>
</head>
<body>
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="brand">La Hora del Arbitraje</div>
      <a href="/admin" class={path === '/admin' ? 'active' : ''}>Artículos</a>
      <a href="/admin/nuevo" class={path === '/admin/nuevo' ? 'active' : ''}>Nuevo artículo</a>
      <a href="/" target="_blank">Ver sitio ↗</a>
      <form method="POST" action="/api/auth/logout">
        <button class="btn btn-secondary" type="submit" style="width:100%; justify-content:center;">
          Cerrar sesión
        </button>
      </form>
    </aside>
    <main class="admin-main">
      <slot />
    </main>
  </div>
</body>
</html>
