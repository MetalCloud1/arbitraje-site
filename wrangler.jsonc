{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arbitraje-site",
  // Punto de entrada unificado del adaptador (Astro 6+ / @astrojs/cloudflare v13+).
  // Sirve tanto para `astro dev` / `astro preview` como para `wrangler deploy`.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["nodejs_compat"],
  // No hace falta declarar el resto de "assets" (directory/binding): el
  // adaptador lo genera. Solo agregamos run_worker_first para las páginas
  // prerenderizadas: por defecto Cloudflare las serviría como archivo
  // estático saltándose el Worker (y por lo tanto el middleware) por
  // completo, lo que dejaría sin efecto el redirect 301 www->apex para
  // justo estas rutas. La solución completa (que cubre TODO el sitio, no
  // solo estas 4 rutas) es un Bulk Redirect a nivel de dominio en el
  // dashboard de Cloudflare -- esto es solo el respaldo de código mientras
  // tanto.
  "assets": {
    "run_worker_first": [
      "/sobre-nosotros",
      "/politica-de-privacidad",
      "/terminos-y-condiciones",
      "/cursos"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arbitraje_db",
      "database_id": "a72976d5-660a-43e5-b7a7-78bba16ef9c9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_IMAGES",
      "bucket_name": "arbitraje-images"
    }
  ],
  "vars": {
    "ADMIN_USER": "admin",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEut1CrZF_r2jNlG",
    "RESEND_FROM_EMAIL": "contacto@lahoradelarbitraje.pro",
    "ARBITROS_NOTIFY_EMAIL": "gilbertoramirezgr001@gmail.com"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "c32b1fc8dba84a5892b7b84d24bd16bf"
    }
  ]
}
