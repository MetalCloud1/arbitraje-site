{
  "name": "la-hora-del-arbitraje",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "deploy": "astro build && wrangler pages deploy ./dist",
    "db:migrate:local": "wrangler d1 execute arbitraje_db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute arbitraje_db --remote --file=./migrations/0001_init.sql",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "wrangler": "^4.130.0"
  }
}
