# Cabeceras de los archivos estáticos (Cloudflare Workers Static Assets).
# Sin este archivo, Cloudflare manda "max-age=0, must-revalidate" a TODO.

# JS/CSS/imágenes compiladas por Astro (llevan hash en el nombre).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes
/fonts/**
  Cache-Control: public, max-age=31536000, immutable

# Recursos de diseño y assets estáticos generales
/icons/**
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/textures/**
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/widgets/**
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Imágenes y logos de la raíz (nombres fijos)
/arbitros-hero.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/site-title.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-default.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/logo.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/podcast-logo.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon-96x96.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/web-app-manifest-192x192.png
